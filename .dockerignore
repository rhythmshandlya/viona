# Dependencies (will be installed in Docker)
node_modules
**/node_modules

# Build outputs (will be built in Docker)
dist
**/dist
.next
**/.next
out
**/out

# Development files
.git
.gitignore
*.md
LICENSE

# IDE
.vscode
.idea
*.swp
*.swo

# Environment files (secrets should be injected via Railway)
.env
.env.*
!.env.example

# Local data
.minio-data
*.log

# Python virtual environments
.venv
**/.venv
__pycache__
**/__pycache__
*.pyc

# Test files
*.test.ts
*.spec.ts
**/*.test.ts
**/*.spec.ts
coverage
**/.coverage

# Docker files (not needed inside container)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github
.gitlab-ci.yml

# Temp files
tmp
temp
*.tmp

# OS files
.DS_Store
Thumbs.db

# Worker local workspace (ephemeral)
packages/worker/workspace
packages/worker/remotion-template/node_modules
packages/worker/bundles

# API-specific environment variables
# See root .env.example for all configuration options

PORT=4000
DATABASE_URL=postgresql://viona:viona123@localhost:5432/viona
REDIS_URL=redis://localhost:6379

# Storage (S3-compatible, single bucket with prefixes)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_ACCESS_KEY=viona
S3_SECRET_KEY=viona123
S3_USE_SSL=false
S3_BUCKET=cllipify
S3_REGION=us-east-1

# Railway Bucket (auto-injected in prod)
# BUCKET_ENDPOINT=storage.railway.app
# BUCKET_ACCESS_KEY_ID=xxx
# BUCKET_SECRET_ACCESS_KEY=xxx
# BUCKET_NAME=xxx

# =============================================================================
# Stytch Authentication
# =============================================================================
# Get these from https://stytch.com/dashboard
STYTCH_PROJECT_ID=project-live-xxx
STYTCH_SECRET=secret-live-xxx

# Cookie signing secret (change in production)
COOKIE_SECRET=cllipify-dev-secret-change-in-production

# =============================================================================
# E2B Cloud Sandbox (production sandbox provider)
# =============================================================================
# Get an API key from https://e2b.dev/dashboard
# Only used when SANDBOX_PROVIDER=e2b
E2B_API_KEY=e2b_your_key_here
E2B_TEMPLATE_NAME=viona-sandbox

# Sandbox provider selector: docker (default, local) | railway | e2b
SANDBOX_PROVIDER=docker

{
  "name": "@viona/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "proxy": "npx claude-max-api",
    "setup:auth": "python src/agents/setup_claude_auth.py",
    "whisperx:setup": "bash ./scripts/setup-whisperx.sh",
    "whisperx:setup:win": ".\\scripts\\setup-whisperx.bat",
    "enhance:setup": "bash ./scripts/setup-enhance.sh",
    "enhance:setup:win": ".\\scripts\\setup-enhance.bat",
    "upload-template": "tsx scripts/upload-template.ts",
    "download-template": "tsx scripts/download-template.ts",
    "push-tokens": "node scripts/push-claude-tokens.js"
  },
  "dependencies": {
    "@viona/renderer": "workspace:*",
    "@viona/shared": "workspace:*",
    "@viona/templates": "workspace:*",
    "@remotion/bundler": "4.0.422",
    "@remotion/captions": "4.0.422",
    "@remotion/cli": "4.0.422",
    "@remotion/lambda": "4.0.422",
    "@remotion/renderer": "4.0.422",
    "archiver": "^7.0.1",
    "bullmq": "^5.1.0",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.29.3",
    "execa": "^8.0.1",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.5",
    "ioredis": "^5.3.2",
    "minio": "^7.1.3",
    "nanoid": "^5.0.4",
    "openai": "^6.18.0",
    "pg": "^8.11.3",
    "pino": "^10.3.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@types/unzipper": "^0.10.10",
    "better-icons": "^1.0.0",
    "claude-max-api-proxy": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}

{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(./**)",
      "Write(./**)",
      "Edit(./**)",
      "Glob(./**)",
      "Grep(./**)",
      "Read(workspace/**)",
      "Write(workspace/**)",
      "Edit(workspace/**)",
      "Glob(workspace/**)",
      "Grep(workspace/**)",
      "Bash(*)"
    ]
  }
}
DATABASE_URL=postgresql://reelify:reelify123@localhost:5432/reelify
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=reelify
MINIO_SECRET_KEY=reelify123
MINIO_USE_SSL=false
MINIO_BUCKET_UPLOADS=uploads
MINIO_BUCKET_OUTPUTS=outputs

# WhisperX Settings (accurate word timestamps via wav2vec2 alignment)
WHISPER_MODEL=large-v2
WHISPER_LANGUAGE=en
# WHISPER_DEVICE: auto (recommended), cuda, mps (macOS Apple Silicon), or cpu
WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE: float16 (Linux/CUDA), float32 (macOS/CPU - required for MPS)
WHISPER_COMPUTE_TYPE=float32
WHISPER_BATCH_SIZE=16

# Python paths - adjust based on your OS:
# macOS/Linux: ./scripts/.venv/bin/python
# Windows:     ./scripts/.venv/Scripts/python.exe
PYTHON_PATH=./scripts/.venv/bin/python
WHISPERX_SCRIPT_PATH=./scripts/whisperx_transcribe.py

# Audio Enhancement Settings
# Uses a separate venv from WhisperX due to dependency conflicts
ENHANCE_SCRIPT_PATH=./scripts/enhance_audio.py
ENHANCE_PYTHON_PATH=./venv-enhance/bin/python

# LLM Provider Settings (for AI visual generation)
# Options: claude-max, openrouter
LLM_PROVIDER=claude-max
CLAUDE_MAX_PROXY_URL=http://localhost:3456/v1
# OPENROUTER_API_KEY=your-key-here

# OpenHands Settings
OPENHANDS_USE_DOCKER=true
# OPENHANDS_PYTHON_PATH=python  # Override if needed

# Remotion Settings
REMOTION_PROJECT_DIR=./remotion-temp
BUNDLE_OUTPUT_DIR=./bundles

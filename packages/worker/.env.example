# Worker-specific environment variables
# See root .env.example for all configuration options

DATABASE_URL=postgresql://reelify:reelify123@localhost:5432/reelify
REDIS_URL=redis://localhost:6379

# Storage (S3-compatible, single bucket with prefixes)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_ACCESS_KEY=reelify
S3_SECRET_KEY=reelify123
S3_USE_SSL=false
S3_BUCKET=cllipify
S3_REGION=us-east-1

# Railway Bucket (auto-injected in prod)
# BUCKET_ENDPOINT=storage.railway.app
# BUCKET_ACCESS_KEY_ID=xxx
# BUCKET_SECRET_ACCESS_KEY=xxx
# BUCKET_NAME=xxx

# Template name in S3 storage
TEMPLATE_NAME=remotion-template.zip

# Transcription mode: "local" (WhisperX) or "api" (OpenAI Whisper API)
TRANSCRIPTION_MODE=local
# OPENAI_API_KEY=sk-...

# WhisperX settings (only when TRANSCRIPTION_MODE=local)
WHISPER_MODEL=large-v2
WHISPER_LANGUAGE=en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16
WHISPER_BATCH_SIZE=16

# Audio Enhancement
AUDIO_ENHANCEMENT_ENABLED=true

# LLM Word Style Analysis (requires OPENAI_API_KEY, set to true to enable)
# WORD_STYLE_ANALYSIS_ENABLED=true
# WORD_STYLE_ANALYSIS_MODEL=gpt-4o-mini
# Python path (auto-detected if not set, uses miniconda or local venv)
# PYTHON_PATH=

# Claude Agent SDK
ANTHROPIC_API_KEY=
CLAUDE_AGENT_MODEL=claude-sonnet-4-20250514
CLAUDE_AGENT_MAX_THINKING_TOKENS=10000
CLAUDE_AGENT_MAX_TURNS=100
CLAUDE_AGENT_TIMEOUT=2700

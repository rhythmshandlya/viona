          }
        ],
        "hero_moment": {
          "what": "The tree 'breaking' or turning into a red-hot bottleneck visual",
          "frame_range": [
            850,
            950
          ],
          "treatment": "Violent shaking and color shift to warning red"
        },
        "elements_on_stage_at_end": [

    {
      "scene_id": "S03_HeapTrap",
      "frame_range": [
        270,
        600
      ],
      "transcript_segment": "Your first instinct is probably a priority queue, right? A standard binary heap. It works because you always get the most immediate tasks to execute, as the data structure will sort it for you.",
      "narrative_goal": "Introduce the common (but flawed) solution",
      "viewer_takeaway": "Priority queues sort things automatically but have a cost",
      "visual_story": {
        "setup": {
          "description": "Binary tree structure (nodes and lines)",
          "mood": "organized"
        },
        "build_sequence": [
          {
            "at_frame": 280,
            "action": "Binary tree materializes",
            "element": "priority_queue",
            "technique": "grow-from-root",
            "effects": [

            "element": "sorting_action",
            "technique": "node-swapping",
            "effects": [
              "trail-lines"
            ],
            "rationale": "Show the internal sorting work"
          }
        ],
        "hero_moment": {
          "what": "The tree rebalancing smoothly as tasks enter",
          "frame_range": [
            400,

    {
      "scene_id": "S04_Bottleneck",
      "frame_range": [
        600,
        1020
      ],
      "transcript_segment": "But it represents a trap because it operates in logarithmic time. This means every single time you add a timer, you have to sort and rebalance the tree. And when you are handling 10 million connections, that sorting overhead is going to be a bottleneck.",
      "narrative_goal": "Highlight the performance failure at scale",
      "viewer_takeaway": "O(log n) is too slow for 10M items",
      "visual_story": {
        "setup": {
          "description": "The tree from before, now massive and complex",
          "mood": "stressful"
        },
        "build_sequence": [
          {

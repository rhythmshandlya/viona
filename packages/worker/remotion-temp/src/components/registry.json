{
  "version": "1.3.0",
  "description": "Pre-built animation components for Visual Generator - Premium quality effects with enhanced visuals",
  "components": [
    {
      "id": "gravity-drop",
      "name": "GravityDrop",
      "path": "./animation/physics/GravityDrop",
      "category": "animation.physics",
      "description": "Objects fall with realistic gravity and bounce",
      "useWhen": ["showing items dropping", "physics demos", "impact effects", "falling elements"],
      "avoidWhen": ["floating effects", "upward motion", "gentle entrances"],
      "props": {
        "dropFrame": "Frame to start the drop animation",
        "targetY": "Target Y position (percentage of height)",
        "bounceCount": "Number of bounces (default: 2)",
        "children": "React node to animate"
      },
      "example": "<GravityDrop dropFrame={30} targetY={80} bounceCount={3}><Ball /></GravityDrop>"
    },
    {
      "id": "bounce",
      "name": "Bounce",
      "path": "./animation/physics/Bounce",
      "category": "animation.physics",
      "description": "Bouncing wrapper with configurable physics",
      "useWhen": ["bouncy entrances", "attention-grabbing reveals", "playful animations"],
      "avoidWhen": ["professional/subtle animations", "minimal style"],
      "props": {
        "startFrame": "Frame to start bouncing",
        "damping": "Spring damping (lower = more bounce)",
        "stiffness": "Spring stiffness"
      },
      "example": "<Bounce startFrame={15} damping={8}><Icon /></Bounce>"
    },
    {
      "id": "spring-scale",
      "name": "SpringScale",
      "path": "./animation/physics/SpringScale",
      "category": "animation.physics",
      "description": "Scale animation with spring physics",
      "useWhen": ["element entrances", "reveals", "emphasis", "scale from zero"],
      "avoidWhen": ["linear scaling needed"],
      "props": {
        "startFrame": "Frame to start the animation",
        "fromScale": "Initial scale (default: 0)",
        "toScale": "Final scale (default: 1)",
        "config": "Spring config { damping, stiffness }"
      },
      "example": "<SpringScale startFrame={0}><Card /></SpringScale>"
    },
    {
      "id": "path-follow",
      "name": "PathFollow",
      "path": "./animation/path/PathFollow",
      "category": "animation.path",
      "description": "Object follows a bezier curve path - perfect for data flow visualizations",
      "useWhen": ["data flowing", "requests traveling", "connections forming", "process flows"],
      "avoidWhen": ["straight-line motion", "static elements"],
      "props": {
        "startX": "Start X position (percentage)",
        "startY": "Start Y position (percentage)",
        "endX": "End X position (percentage)",
        "endY": "End Y position (percentage)",
        "arcHeight": "Arc height (percentage, negative for upward arc)",
        "startFrame": "Frame to start animation",
        "durationFrames": "Animation duration in frames",
        "showTrail": "Show motion trail (default: false)"
      },
      "example": "<PathFollow startX={10} startY={50} endX={90} endY={50} arcHeight={-20} startFrame={0} durationFrames={60}><DataPacket /></PathFollow>"
    },
    {
      "id": "arc-travel",
      "name": "ArcTravel",
      "path": "./animation/path/ArcTravel",
      "category": "animation.path",
      "description": "Simple arc motion between two points",
      "useWhen": ["object traveling", "connection between two points", "throwing/tossing motion"],
      "avoidWhen": ["complex multi-point paths", "straight lines"],
      "props": {
        "from": "{ x: number, y: number } start position (percentage)",
        "to": "{ x: number, y: number } end position (percentage)",
        "startFrame": "Frame to start",
        "durationFrames": "Duration in frames",
        "arcDirection": "'up' | 'down' (default: 'up')"
      },
      "example": "<ArcTravel from={{x: 20, y: 80}} to={{x: 80, y: 80}} startFrame={30} durationFrames={45}><Ball /></ArcTravel>"
    },
    {
      "id": "stagger",
      "name": "Stagger",
      "path": "./animation/timing/Stagger",
      "category": "animation.timing",
      "description": "Staggered entrance for list items - each child animates sequentially",
      "useWhen": ["list animations", "multiple items entering", "step-by-step reveals"],
      "avoidWhen": ["single elements", "simultaneous animations needed"],
      "props": {
        "startFrame": "Frame when first child starts animating",
        "delayFrames": "Delay between each child (default: 8)",
        "animationType": "'fade' | 'scale' | 'slideUp' | 'slideRight' (default: 'scale')"
      },
      "example": "<Stagger startFrame={30} delayFrames={10}>{items.map((item, i) => <Item key={i} data={item} />)}</Stagger>"
    },
    {
      "id": "sequence-animation",
      "name": "SequenceAnimation",
      "path": "./animation/timing/SequenceAnimation",
      "category": "animation.timing",
      "description": "Sequential animations that play one after another",
      "useWhen": ["step sequences", "chained animations", "timeline control"],
      "avoidWhen": ["parallel animations", "simple single animations"],
      "props": {
        "steps": "Array of { duration: number, render: (progress) => ReactNode }",
        "startFrame": "Frame to start the sequence"
      },
      "example": "See component documentation"
    },
    {
      "id": "particle-stream",
      "name": "ParticleStream",
      "path": "./visual/particles/ParticleStream",
      "category": "visual.particles",
      "description": "Premium particle flow with depth layers, motion trails, and multi-layered glow effects",
      "useWhen": ["data streaming", "network traffic", "showing flow/direction", "scale visualization", "premium backgrounds"],
      "avoidWhen": ["static diagrams", "precise data representation"],
      "props": {
        "direction": "'left' | 'right' | 'up' | 'down' (default: 'right')",
        "density": "Number of particles (default: 30)",
        "color": "Primary particle color (default: '#06b6d4')",
        "secondaryColor": "Secondary color for gradient particles",
        "speed": "Animation speed multiplier (default: 1)",
        "particleSize": "Size multiplier (default: 1)",
        "shape": "'circle' | 'dot' | 'line' | 'mixed' (default: 'circle')",
        "trails": "Show motion trails behind particles (default: false)",
        "trailLength": "Trail length multiplier (default: 1)",
        "depth": "Add depth variation - some particles appear closer (default: false)",
        "pulse": "Subtle breathing animation (default: false)",
        "glowIntensity": "Glow strength multiplier (default: 1)"
      },
      "example": "<ParticleStream direction=\"right\" density={50} color=\"#8b5cf6\" trails depth />"
    },
    {
      "id": "confetti",
      "name": "Confetti",
      "path": "./visual/particles/Confetti",
      "category": "visual.particles",
      "description": "Celebration effect with colorful confetti",
      "useWhen": ["success states", "celebrations", "achievements", "completion"],
      "avoidWhen": ["serious/professional content", "error states"],
      "props": {
        "triggerFrame": "Frame when confetti explodes",
        "colors": "Array of colors (default: rainbow)",
        "count": "Number of confetti pieces (default: 50)",
        "spread": "Spread angle in degrees (default: 60)"
      },
      "example": "<Confetti triggerFrame={120} colors={['#8b5cf6', '#06b6d4', '#22c55e']} />"
    },
    {
      "id": "burst",
      "name": "Burst",
      "path": "./visual/particles/Burst",
      "category": "visual.particles",
      "description": "Radial burst effect - particles explode outward from center",
      "useWhen": ["impact moments", "reveals", "emphasis", "explosions"],
      "avoidWhen": ["subtle animations", "continuous effects"],
      "props": {
        "triggerFrame": "Frame when burst occurs",
        "x": "Center X position (percentage)",
        "y": "Center Y position (percentage)",
        "color": "Burst color",
        "particleCount": "Number of particles (default: 12)",
        "radius": "Burst radius (percentage, default: 20)"
      },
      "example": "<Burst triggerFrame={60} x={50} y={50} color=\"#8b5cf6\" />"
    },
    {
      "id": "glowing-orb",
      "name": "GlowingOrb",
      "path": "./visual/shapes/GlowingOrb",
      "category": "visual.shapes",
      "description": "Premium pulsing orb with multi-layered glow, inner highlights, and optional sparkle effects",
      "useWhen": ["server representations", "data nodes", "active states", "energy sources", "premium visuals"],
      "avoidWhen": ["static diagrams", "minimal style"],
      "props": {
        "size": "Size multiplier (default: 1)",
        "color": "Primary color (default: '#8b5cf6')",
        "secondaryColor": "Secondary color for gradient (optional)",
        "glowIntensity": "Glow strength (default: 1)",
        "pulseSpeed": "Pulse animation speed (default: 1)",
        "sparkle": "Add rotating sparkle rays (default: false)",
        "ring": "Add outer pulsing ring (default: false)",
        "ringColor": "Ring color (defaults to color with low opacity)"
      },
      "example": "<GlowingOrb size={1.5} color=\"#06b6d4\" sparkle ring />"
    },
    {
      "id": "progress-ring",
      "name": "ProgressRing",
      "path": "./visual/shapes/ProgressRing",
      "category": "visual.shapes",
      "description": "Circular progress indicator with animated fill",
      "useWhen": ["progress visualization", "loading states", "completion percentage", "metrics"],
      "avoidWhen": ["linear progress", "non-percentage values"],
      "props": {
        "progress": "Progress value 0-1 OR start/end frames for animation",
        "startFrame": "If animating: frame to start",
        "endFrame": "If animating: frame when 100%",
        "size": "Ring size multiplier (default: 1)",
        "color": "Ring color",
        "backgroundColor": "Background ring color",
        "strokeWidth": "Stroke width multiplier (default: 1)"
      },
      "example": "<ProgressRing startFrame={0} endFrame={90} color=\"#22c55e\" />"
    },
    {
      "id": "glass-card",
      "name": "GlassCard",
      "path": "./visual/shapes/GlassCard",
      "category": "visual.shapes",
      "description": "Premium glassmorphism card with layered depth, gradient borders, inner reflections, and optional shimmer",
      "useWhen": ["premium UI", "feature cards", "modern aesthetics", "overlay content"],
      "avoidWhen": ["minimal designs", "performance-critical renders"],
      "props": {
        "blur": "Background blur intensity (default: 20)",
        "backgroundOpacity": "Background opacity (default: 0.08)",
        "borderOpacity": "Border opacity (default: 0.15)",
        "accentColor": "Accent color for tint",
        "enterFrame": "Frame when card appears",
        "animation": "'scale' | 'fade' | 'slideUp' | 'none'",
        "glow": "Add multi-layered glow effect (default: false)",
        "innerHighlight": "Add top edge reflection (default: true)",
        "shimmer": "Add animated shimmer sweep (default: false)",
        "borderRadius": "Border radius multiplier (default: 1)"
      },
      "example": "<GlassCard enterFrame={30} animation=\"scale\" glow innerHighlight shimmer><Content /></GlassCard>"
    },
    {
      "id": "gradient-text",
      "name": "GradientText",
      "path": "./visual/shapes/GradientText",
      "category": "visual.shapes",
      "description": "Animated gradient text for eye-catching headings",
      "useWhen": ["titles", "hero text", "feature names", "emphasis"],
      "avoidWhen": ["body text", "subtle designs"],
      "props": {
        "text": "Text to display",
        "colors": "Gradient colors array",
        "angle": "Gradient angle in degrees",
        "animateGradient": "Animate gradient movement",
        "glow": "Add text glow effect"
      },
      "example": "<GradientText text=\"Amazing Feature\" colors={['#8b5cf6', '#06b6d4']} animateGradient glow />"
    },
    {
      "id": "glow",
      "name": "Glow",
      "path": "./visual/effects/Glow",
      "category": "visual.effects",
      "description": "Adds animated glow effect wrapper to any element",
      "useWhen": ["highlighting elements", "active states", "emphasis"],
      "avoidWhen": ["minimal designs", "too many glowing elements"],
      "props": {
        "color": "Glow color",
        "intensity": "Glow intensity (default: 1)",
        "pulse": "Enable pulsing (default: true)",
        "pulseSpeed": "Pulse speed (default: 1)"
      },
      "example": "<Glow color=\"#8b5cf6\" intensity={1.5}><Icon /></Glow>"
    },
    {
      "id": "shimmer",
      "name": "Shimmer",
      "path": "./visual/effects/Shimmer",
      "category": "visual.effects",
      "description": "Sweeping shimmer/shine effect for premium feel",
      "useWhen": ["new items", "premium features", "polish"],
      "avoidWhen": ["frequent animations", "many elements"],
      "props": {
        "durationFrames": "Shimmer duration",
        "delayFrames": "Delay before shimmer",
        "loop": "Loop the animation",
        "color": "Shimmer color"
      },
      "example": "<Shimmer delayFrames={30} durationFrames={45}><Card /></Shimmer>"
    },
    {
      "id": "type-writer",
      "name": "TypeWriter",
      "path": "./visual/effects/TypeWriter",
      "category": "visual.effects",
      "description": "Animated text typing effect with cursor",
      "useWhen": ["code examples", "terminal output", "dramatic reveals"],
      "avoidWhen": ["fast-paced content", "non-text content"],
      "props": {
        "text": "Text to type",
        "startFrame": "Frame when typing starts",
        "framesPerChar": "Speed (frames per character)",
        "showCursor": "Show blinking cursor",
        "monospace": "Use monospace font"
      },
      "example": "<TypeWriter text=\"Hello, World!\" startFrame={30} showCursor />"
    },
    {
      "id": "counter",
      "name": "Counter",
      "path": "./visual/data/Counter",
      "category": "visual.data",
      "description": "Premium animated counter with refined typography, glow effects, gradient text, and easing styles",
      "useWhen": ["showing numbers growing", "statistics", "metrics", "countdowns", "hero numbers"],
      "avoidWhen": ["static numbers", "non-numeric data"],
      "props": {
        "from": "Starting number",
        "to": "Target number",
        "startFrame": "Frame to start counting",
        "durationFrames": "Duration of count animation",
        "format": "'none' | 'compact' | 'currency' | 'percent' (default: 'none')",
        "prefix": "Text before number (e.g., '$')",
        "suffix": "Text after number (e.g., '%')",
        "animationStyle": "'smooth' | 'bounce' | 'spring' | 'dramatic' (default: 'smooth')",
        "glow": "Add multi-layered glow effect (default: false)",
        "glowColor": "Glow color (defaults to text color)",
        "gradient": "Apply gradient to text (default: false)",
        "gradientColors": "Gradient colors array (default: ['#8b5cf6', '#06b6d4'])",
        "punchOnComplete": "Scale punch effect when complete (default: false)"
      },
      "example": "<Counter from={0} to={1000000} startFrame={0} durationFrames={90} format=\"compact\" glow gradient punchOnComplete />"
    },
    {
      "id": "bar-chart",
      "name": "BarChart",
      "path": "./visual/data/BarChart",
      "category": "visual.data",
      "description": "Animated bar chart with growing bars",
      "useWhen": ["comparing values", "showing metrics", "data visualization"],
      "avoidWhen": ["continuous data", "time series (use LineGraph)"],
      "props": {
        "data": "Array of { label: string, value: number, color?: string }",
        "startFrame": "Frame to start bar growth",
        "staggerFrames": "Delay between each bar (default: 5)",
        "durationFrames": "Duration for each bar to grow",
        "showLabels": "Show value labels (default: true)"
      },
      "example": "<BarChart data={[{label: 'A', value: 80}, {label: 'B', value: 60}]} startFrame={30} />"
    },
    {
      "id": "line-graph",
      "name": "LineGraph",
      "path": "./visual/data/LineGraph",
      "category": "visual.data",
      "description": "Animated line graph that draws progressively",
      "useWhen": ["time series", "trends", "continuous data", "progress over time"],
      "avoidWhen": ["categorical comparisons (use BarChart)"],
      "props": {
        "data": "Array of { x: number, y: number }",
        "startFrame": "Frame to start drawing",
        "durationFrames": "Duration to draw complete line",
        "color": "Line color",
        "showDots": "Show data points (default: true)",
        "fillArea": "Fill area under line (default: false)"
      },
      "example": "<LineGraph data={points} startFrame={0} durationFrames={120} color=\"#8b5cf6\" />"
    },
    {
      "id": "safe-zone",
      "name": "SafeZone",
      "path": "./layout/SafeZone",
      "category": "layout",
      "description": "Container that respects subtitle safe zone (bottom 15%)",
      "useWhen": ["all compositions", "ensuring content doesn't overlap subtitles"],
      "avoidWhen": ["never - always use for main content"],
      "props": {
        "padding": "Additional padding multiplier (default: 1)"
      },
      "example": "<SafeZone><YourContent /></SafeZone>"
    },
    {
      "id": "noise-background",
      "name": "NoiseBackground",
      "path": "./visual/effects/NoiseBackground",
      "category": "visual.effects",
      "description": "Procedural noise texture using @remotion/noise for premium backgrounds",
      "useWhen": ["background textures", "organic effects", "premium aesthetics", "animated backgrounds"],
      "avoidWhen": ["simple solid backgrounds", "performance-critical renders"],
      "props": {
        "color": "Base color for the noise",
        "secondaryColor": "Secondary color for gradient effect",
        "scale": "Noise scale - smaller = larger patterns (default: 0.005)",
        "speed": "Animation speed (default: 1, 0 for static)",
        "intensity": "Noise contrast (default: 1)",
        "type": "'perlin' | 'grain' | 'clouds' (default: 'perlin')",
        "opacity": "Opacity (default: 0.3)",
        "resolution": "Resolution divisor for performance (default: 4)"
      },
      "example": "<NoiseBackground color=\"#8b5cf6\" type=\"clouds\" speed={0.5} />"
    },
    {
      "id": "animated-shape",
      "name": "AnimatedShape",
      "path": "./visual/shapes/AnimatedShape",
      "category": "visual.shapes",
      "description": "Animated geometric shapes using @remotion/shapes - stars, hearts, triangles, etc.",
      "useWhen": ["animated icons", "decorative elements", "visual emphasis", "draw-on effects"],
      "avoidWhen": ["complex custom shapes", "detailed illustrations"],
      "props": {
        "shape": "'star' | 'circle' | 'triangle' | 'rect' | 'pie' | 'polygon' | 'heart' | 'ellipse'",
        "size": "Size of the shape",
        "fill": "Fill color",
        "stroke": "Stroke color",
        "animation": "'draw' | 'scale' | 'morph' | 'pulse' | 'rotate' | 'none'",
        "startFrame": "Frame to start animation",
        "durationFrames": "Animation duration",
        "points": "For star: number of points",
        "glow": "Add glow effect"
      },
      "example": "<AnimatedShape shape=\"star\" size={100} fill=\"#8b5cf6\" animation=\"draw\" />"
    },
    {
      "id": "motion-blur-wrapper",
      "name": "MotionBlurWrapper",
      "path": "./animation/effects/MotionBlurWrapper",
      "category": "animation.effects",
      "description": "Easy motion blur using @remotion/motion-blur for fast-moving elements",
      "useWhen": ["fast-moving objects", "cinematic effects", "action sequences"],
      "avoidWhen": ["static elements", "slow animations"],
      "props": {
        "type": "'trail' | 'camera' (default: 'trail')",
        "trailAmount": "Number of ghost images (default: 5)",
        "trailLag": "Lag between ghosts in frames (default: 0.1)",
        "cameraSamples": "For camera: blur samples (default: 10)",
        "shutterAngle": "For camera: shutter angle (default: 180)"
      },
      "example": "<MotionBlurWrapper type=\"trail\" trailAmount={5}><FastObject /></MotionBlurWrapper>"
    },
    {
      "id": "scene-transition",
      "name": "SceneTransition",
      "path": "./animation/timing/SceneTransition",
      "category": "animation.timing",
      "description": "Easy scene transitions using @remotion/transitions - fade, slide, wipe, flip",
      "useWhen": ["scene changes", "professional transitions", "multi-scene videos"],
      "avoidWhen": ["single scene videos", "custom transitions"],
      "props": {
        "scenes": "Array of { durationInFrames, content }",
        "transition": "'fade' | 'slide-left' | 'slide-right' | 'slide-up' | 'slide-down' | 'wipe' | 'flip'",
        "transitionDuration": "Transition duration in frames (default: 15)",
        "timing": "'linear' | 'spring' (default: 'spring')"
      },
      "example": "<SceneTransition transition=\"slide-left\" scenes={[{durationInFrames: 90, content: <Scene1 />}]} />"
    },
    {
      "id": "premium-entrance",
      "name": "PremiumEntrance",
      "path": "./animation/premium/PremiumEntrance",
      "category": "animation.premium",
      "description": "Configurable premium entrance animation - BounceIn, FadeInUp, ZoomIn, FlipInX, RotateIn, LightSpeedIn, SlideInRotate",
      "useWhen": ["hero titles", "key reveals", "dramatic introductions", "section headers", "first impressions"],
      "avoidWhen": ["background elements", "subtle secondary content", "rapid sequences"],
      "props": {
        "animation": "'bounceIn' | 'fadeInUp' | 'fadeInDown' | 'zoomIn' | 'flipInX' | 'rotateIn' | 'lightSpeedIn' | 'slideInRotate'",
        "delay": "Frame to start animation",
        "duration": "Override default duration",
        "style": "Style preset (minimal, modern, playful, bold, classic)",
        "speed": "'fast' | 'normal' | 'slow'"
      },
      "example": "<PremiumEntrance animation=\"bounceIn\" delay={0} style=\"modern\"><h1>Hero Title</h1></PremiumEntrance>"
    },
    {
      "id": "attention-seeker",
      "name": "AttentionSeeker",
      "path": "./animation/premium/AttentionSeeker",
      "category": "animation.premium",
      "description": "Emphasis effects - Pulse, Shake, Tada, Wobble, HeartBeat, Flash, GlowPulse to draw attention",
      "useWhen": ["highlighting key stats", "success moments", "warnings/errors", "important reveals", "CTAs"],
      "avoidWhen": ["overusing on many elements", "subtle content", "minimal style"],
      "props": {
        "effect": "'pulse' | 'shake' | 'tada' | 'wobble' | 'heartBeat' | 'flash' | 'glowPulse'",
        "startFrame": "Frame when effect begins",
        "duration": "Effect duration in frames",
        "style": "Style preset",
        "color": "Glow color (for glowPulse effect)"
      },
      "example": "<AttentionSeeker effect=\"tada\" startFrame={60}><Counter to={1000000} /></AttentionSeeker>"
    },
    {
      "id": "combined-animation",
      "name": "CombinedAnimation",
      "path": "./animation/premium/CombinedAnimation",
      "category": "animation.premium",
      "description": "Chain entrance + emphasis + exit in one component for full animation lifecycle",
      "useWhen": ["elements that enter and leave", "feature spotlights", "scene-scoped elements"],
      "avoidWhen": ["persistent elements", "simple entrances only"],
      "props": {
        "entrance": "'bounceIn' | 'fadeInUp' | 'fadeInDown' | 'zoomIn' | 'flipInX' | 'rotateIn' | 'lightSpeedIn'",
        "emphasis": "'pulse' | 'shake' | 'tada' | 'wobble' | 'heartBeat' | 'glowPulse' (optional)",
        "emphasisFrame": "Frame when emphasis plays",
        "emphasisDuration": "Duration of emphasis",
        "exit": "'bounceOut' | 'fadeOutUp' | 'zoomOut' (optional)",
        "exitFrame": "Frame when exit begins",
        "style": "Style preset",
        "speed": "'fast' | 'normal' | 'slow'"
      },
      "example": "<CombinedAnimation entrance=\"fadeInUp\" emphasis=\"pulse\" emphasisFrame={60} exit=\"zoomOut\" exitFrame={150} style=\"modern\"><Card /></CombinedAnimation>"
    },
    {
      "id": "audio-waveform",
      "name": "AudioWaveform",
      "path": "./visual/data/AudioWaveform",
      "category": "visual.data",
      "description": "Audio visualization using @remotion/media-utils - bars, lines, circular waveforms",
      "useWhen": ["audiograms", "music visualization", "podcast videos", "audio-reactive content"],
      "avoidWhen": ["no audio content", "static displays"],
      "props": {
        "audioSrc": "Path to audio file",
        "style": "'bars' | 'line' | 'circular' | 'dots' (default: 'bars')",
        "color": "Primary color",
        "secondaryColor": "Gradient end color",
        "numberOfSamples": "Frequency samples (default: 64)",
        "glow": "Add glow effect",
        "mirror": "Mirror the waveform"
      },
      "example": "<AudioWaveform audioSrc={staticFile('audio.mp3')} style=\"bars\" color=\"#8b5cf6\" />"
    }
  ],
  "categories": {
    "animation.physics": "Physics-based animations (gravity, bounce, spring)",
    "animation.path": "Path-following and motion animations",
    "animation.timing": "Timing and sequencing helpers",
    "animation.effects": "Motion blur and cinematic effects",
    "animation.premium": "Premium A1 entrance, exit, and emphasis animations",
    "visual.particles": "Particle effects (streams, bursts, confetti)",
    "visual.shapes": "Animated shape components (orbs, cards, progress)",
    "visual.effects": "Visual enhancement effects (glow, shimmer, typing)",
    "visual.data": "Data visualization components",
    "layout": "Layout and positioning helpers"
  },
  "utilities": {
    "easing": "Pre-configured easing curves (EASING.smoothOut, EASING.dramatic, etc.)",
    "springConfigs": "Spring presets (SPRING_CONFIGS.bouncy, SPRING_CONFIGS.snappy, etc.)",
    "timing": "Frame timing constants (TIMING.fast, TIMING.dramatic, etc.)",
    "colors": "Enhanced color utilities: PALETTES (8 premium palettes), GRADIENTS (preset gradients), SEMANTIC_COLORS",
    "colorFunctions": "Color manipulation: lighten, darken, withAlpha, mix, layeredGlow, premiumShadow, glassBackground, colorScheme"
  }
}

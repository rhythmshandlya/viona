{
  "name": "@viona/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.mjs",
      "require": "./dist/storage.js"
    },
    "./queue-types": {
      "types": "./dist/queue-types.d.ts",
      "import": "./dist/queue-types.mjs",
      "require": "./dist/queue-types.js"
    },
    "./progress-types": {
      "types": "./dist/progress-types.d.ts",
      "import": "./dist/progress-types.mjs",
      "require": "./dist/progress-types.js"
    },
    "./typography-pairings": {
      "types": "./dist/typography-pairings.d.ts",
      "import": "./dist/typography-pairings.mjs",
      "require": "./dist/typography-pairings.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "minio": "^7.1.3",
    "nanoid": "^5.1.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}

# Build scripts (not needed in image)
build.sh
build.ps1

# Git
.git
.gitignore

# IDE
.vscode
.idea

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Symlinks/junctions (Docker can't handle Windows symlinks)
templates/openhands-sandbox/.openhands
templates/openhands-sandbox/.agents
templates/openhands-sandbox/skills

# Node modules (platform-specific, must be installed inside Docker)
templates/openhands-sandbox/node_modules
**/node_modules

# Python cache
__pycache__
*.pyc
.pytest_cache

# =============================================================================
# Cllipify Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# For package-specific overrides, create .env files in apps/web, packages/api, etc.

NODE_ENV=development

# =============================================================================
# Docker Compose (optional - defaults work out of the box)
# =============================================================================
# Customize ports and credentials if needed
# POSTGRES_PORT=5432
# POSTGRES_USER=viona
# POSTGRES_PASSWORD=viona123
# POSTGRES_DB=viona
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MINIO_ROOT_USER=viona
# MINIO_ROOT_PASSWORD=viona123
# REDIS_PORT=6379

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql://viona:viona123@localhost:5432/viona

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# Storage (S3-compatible)
# =============================================================================
# Local development uses MinIO (docker-compose)
# Production uses Railway Buckets (auto-configured)
#
# Structure: Single bucket with prefixes
#   - uploads/   → user uploaded files
#   - outputs/   → generated outputs (bundles, videos)
#   - templates/ → remotion template files

# Local MinIO settings
S3_ENDPOINT=localhost
S3_PORT=9000
S3_ACCESS_KEY=viona
S3_SECRET_KEY=viona123
S3_USE_SSL=false
S3_BUCKET=cllipify
S3_REGION=us-east-1

# Railway Bucket (auto-injected in prod, no need to set manually)
# BUCKET_ENDPOINT=storage.railway.app
# BUCKET_ACCESS_KEY_ID=xxx
# BUCKET_SECRET_ACCESS_KEY=xxx
# BUCKET_NAME=xxx
# BUCKET_REGION=us-east-1

# =============================================================================
# Transcription
# =============================================================================
# Mode: "local" uses WhisperX (requires Python), "api" uses OpenAI Whisper API
TRANSCRIPTION_MODE=local

# Required when TRANSCRIPTION_MODE=api
# OPENAI_API_KEY=sk-...

# WhisperX settings (only used when TRANSCRIPTION_MODE=local)
WHISPER_MODEL=large-v2
WHISPER_LANGUAGE=en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16
WHISPER_BATCH_SIZE=16

# =============================================================================
# Audio Enhancement
# =============================================================================
# Set to false to disable audio enhancement (disabled in prod)
AUDIO_ENHANCEMENT_ENABLED=true

# =============================================================================
# Python (for Claude Agent SDK and WhisperX)
# =============================================================================
# Path to Python executable. If not set, will check for:
# - Conda environment (CONDA_PREFIX)
# - Local venv (.venv/Scripts/python.exe or .venv/bin/python)
# PYTHON_PATH=C:\Users\<you>\miniconda3\envs\cllipify\python.exe

# =============================================================================
# Claude Agent SDK (for visual generation)
# =============================================================================
# REQUIRED on BOTH api + worker containers in production.
# - API: used by the creative director + sandbox-dispatched arrangement runs.
# - Worker: used by the mirrored arrangement orchestrator (runs in-worker, not
#   sandbox). Missing the key on worker = silent arrangement-job failures.
ANTHROPIC_API_KEY=

# Claude Agent model settings
CLAUDE_AGENT_MODEL=claude-sonnet-4-20250514

# Creative Director Agent
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
CLAUDE_AGENT_MAX_THINKING_TOKENS=10000
CLAUDE_AGENT_MAX_TURNS=100
CLAUDE_AGENT_TIMEOUT=2700

# =============================================================================
# API Server
# =============================================================================
PORT=4000
API_URL=http://localhost:4000

# =============================================================================
# Web App
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ---- GPU inference dispatch ----
# Provider for the /internal/sandbox/:id/inference endpoint.
#   worker — run locally via BullMQ + subprocess (dev default, CI, RunPod fallback)
#   runpod — submit to RunPod Serverless (Railway prod default)
INFERENCE_PROVIDER=worker

# ---- RunPod Serverless (only needed when INFERENCE_PROVIDER=runpod) ----
# API key from runpod.io → Settings → API Keys. Used by API service only.
RUNPOD_API_KEY=
# Endpoint ID from runpod.io → Serverless → viona-rvm (created in Task 6).
RUNPOD_RVM_ENDPOINT_ID=
# HS256 shared secret for signing webhook callback JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RUNPOD_WEBHOOK_SECRET=
# Public base URL of this API, used to build the webhook URL for RunPod.
# Example: https://api.viona.co . On Railway defaults to RAILWAY_PUBLIC_DOMAIN.
RUNPOD_WEBHOOK_BASE_URL=

# =============================================================================
# Cllipify Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# For package-specific overrides, create .env files in apps/web, packages/api, etc.

NODE_ENV=development

# =============================================================================
# Docker Compose (optional - defaults work out of the box)
# =============================================================================
# Customize ports and credentials if needed
# POSTGRES_PORT=5432
# POSTGRES_USER=reelify
# POSTGRES_PASSWORD=reelify123
# POSTGRES_DB=reelify
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MINIO_ROOT_USER=reelify
# MINIO_ROOT_PASSWORD=reelify123
# REDIS_PORT=6379

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql://reelify:reelify123@localhost:5432/reelify

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# Storage (S3-compatible)
# =============================================================================
# Local development uses MinIO (docker-compose)
# Production uses Railway Buckets (auto-configured)
#
# Structure: Single bucket with prefixes
#   - uploads/   → user uploaded files
#   - outputs/   → generated outputs (bundles, videos)
#   - templates/ → remotion template files

# Local MinIO settings
S3_ENDPOINT=localhost
S3_PORT=9000
S3_ACCESS_KEY=reelify
S3_SECRET_KEY=reelify123
S3_USE_SSL=false
S3_BUCKET=cllipify
S3_REGION=us-east-1

# Railway Bucket (auto-injected in prod, no need to set manually)
# BUCKET_ENDPOINT=storage.railway.app
# BUCKET_ACCESS_KEY_ID=xxx
# BUCKET_SECRET_ACCESS_KEY=xxx
# BUCKET_NAME=xxx
# BUCKET_REGION=us-east-1

# =============================================================================
# Transcription
# =============================================================================
# Mode: "local" uses WhisperX (requires Python), "api" uses OpenAI Whisper API
TRANSCRIPTION_MODE=local

# Required when TRANSCRIPTION_MODE=api
# OPENAI_API_KEY=sk-...

# WhisperX settings (only used when TRANSCRIPTION_MODE=local)
WHISPER_MODEL=large-v2
WHISPER_LANGUAGE=en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16
WHISPER_BATCH_SIZE=16

# =============================================================================
# Audio Enhancement
# =============================================================================
# Set to false to disable audio enhancement (disabled in prod)
AUDIO_ENHANCEMENT_ENABLED=true

# =============================================================================
# Python (for Claude Agent SDK and WhisperX)
# =============================================================================
# Path to Python executable. If not set, will check for:
# - Conda environment (CONDA_PREFIX)
# - Local venv (.venv/Scripts/python.exe or .venv/bin/python)
# PYTHON_PATH=C:\Users\<you>\miniconda3\envs\cllipify\python.exe

# =============================================================================
# Claude Agent SDK (for visual generation)
# =============================================================================
ANTHROPIC_API_KEY=

# Claude Agent model settings
CLAUDE_AGENT_MODEL=claude-sonnet-4-20250514

# Creative Director Agent
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
CLAUDE_AGENT_MAX_THINKING_TOKENS=10000
CLAUDE_AGENT_MAX_TURNS=100
CLAUDE_AGENT_TIMEOUT=2700

# =============================================================================
# API Server
# =============================================================================
PORT=4000
API_URL=http://localhost:4000

# =============================================================================
# Web App
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

[build]
builder = "dockerfile"
dockerfilePath = "apps/web/Dockerfile"
# Build from repo root to include workspace dependencies
watchPatterns = ["apps/web/**", "packages/shared/**", "packages/renderer/**"]

[deploy]
healthcheckPath = "/"
healthcheckTimeout = 30
restartPolicyType = "on_failure"
restartPolicyMaxRetries = 3

# =============================================================================
# Web App Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values

# =============================================================================
# API Connection
# =============================================================================
# Local development (default)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Production (Railway auto-configures these)
# NEXT_PUBLIC_API_URL=https://your-api.railway.app
# NEXT_PUBLIC_WS_URL=wss://your-api.railway.app

# =============================================================================
# Database (for server-side operations)
# =============================================================================
# Only needed if web app does direct DB queries
# DATABASE_URL=postgresql://viona:viona123@localhost:5432/viona

# =============================================================================
# Feature Flags (optional)
# =============================================================================
# NEXT_PUBLIC_ENABLE_DEBUG=false

# =============================================================================
# Stytch Authentication
# =============================================================================
# Get this from https://stytch.com/dashboard
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=public-token-xxx

# App URL (for auth redirects)
NEXT_PUBLIC_URL=http://localhost:3000

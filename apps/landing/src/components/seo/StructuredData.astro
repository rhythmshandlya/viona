---
import { siteConfig } from "@/data/site";
import { faqs } from "@/data/testimonials";
import { pricingFaqs } from "@/data/pricing-faqs";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

const normalized = pathname.replace(/\/$/, "") || "/";
const isHomepage = normalized === "/";
const isPricing = normalized === "/pricing";

const faqPageSchema = (items: { question: string; answer: string }[]) => ({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.answer,
    },
  })),
});

// --- Homepage schemas: WebSite + Organization + SoftwareApplication ---

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
};

const sameAs = Object.values(siteConfig.links).filter(Boolean);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  logo: {
    "@type": "ImageObject",
    url: `${siteConfig.url}/favicon.svg`,
  },
  contactPoint: {
    "@type": "ContactPoint",
    email: siteConfig.contact,
    contactType: "customer support",
  },
  ...(sameAs.length > 0 ? { sameAs } : {}),
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: siteConfig.name,
  description: siteConfig.description,
  url: siteConfig.url,
  operatingSystem: "Web",
  screenshot: `${siteConfig.url}/assets/screenshots/editor-chat.png`,
  applicationCategory: "MultimediaApplication",
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "USD",
    lowPrice: "0",
    highPrice: "29",
    offerCount: 2,
    offers: [
      {
        "@type": "Offer",
        name: "Starter",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/OnlineOnly",
        url: `${siteConfig.url}/pricing/`,
      },
      {
        "@type": "Offer",
        name: "Pro",
        price: "29",
        priceCurrency: "USD",
        availability: "https://schema.org/OnlineOnly",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: "29",
          priceCurrency: "USD",
          billingDuration: "P1M",
        },
        url: `${siteConfig.url}/pricing/`,
      },
    ],
  },
};

// --- Subpage schemas: BreadcrumbList + WebPage ---

const segments = pathname.replace(/\/$/, "").split("/").filter(Boolean);

// Preserve known acronyms as uppercase; otherwise title-case each hyphen-separated word.
const ACRONYMS = new Set(["ai", "api", "seo", "ui", "ux", "faq", "sdk", "cli"]);
const formatSegment = (segment: string) =>
  segment
    .split("-")
    .map((word) => (ACRONYMS.has(word.toLowerCase()) ? word.toUpperCase() : word.charAt(0).toUpperCase() + word.slice(1)))
    .join(" ");

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteConfig.url,
    },
    ...segments.map((segment, index) => ({
      "@type": "ListItem" as const,
      position: index + 2,
      name: formatSegment(segment),
      item: `${siteConfig.url}/${segments.slice(0, index + 1).join("/")}/`,
    })),
  ],
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: segments.length > 0 ? formatSegment(segments[segments.length - 1]) : siteConfig.name,
  url: `${siteConfig.url}${pathname}`,
  isPartOf: {
    "@type": "WebSite",
    name: siteConfig.name,
    url: siteConfig.url,
  },
};

const schemas: Record<string, unknown>[] = isHomepage
  ? [websiteSchema, organizationSchema, softwareSchema, faqPageSchema(faqs)]
  : [breadcrumbSchema, webPageSchema];

if (isPricing) {
  schemas.push(faqPageSchema(pricingFaqs));
}
---

{schemas.map((schema) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

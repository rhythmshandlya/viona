---
import { siteConfig } from "@/data/site";
import { faqs } from "@/data/testimonials";

interface Props {
  type?: "WebSite" | "Organization" | "SoftwareApplication" | "FAQPage" | "WebPage" | "BreadcrumbList";
}

const { type = "WebSite" } = Astro.props;

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteConfig.url}/#website`,
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  publisher: {
    "@id": `${siteConfig.url}/#organization`,
  },
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteConfig.url}/#organization`,
  name: siteConfig.name,
  url: siteConfig.url,
  logo: {
    "@type": "ImageObject",
    url: `${siteConfig.url}/og-image.png`,
    width: 1200,
    height: 630,
  },
  description: siteConfig.description,
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `${siteConfig.url}/#software`,
  name: siteConfig.name,
  url: siteConfig.url,
  operatingSystem: "Any",
  applicationCategory: "MultimediaApplication",
  applicationSubCategory: "Video Editing",
  description: siteConfig.description,
  featureList: [
    "AI-generated visuals from speech",
    "20+ animated caption presets",
    "Multi-format export (9:16, 16:9, 1:1)",
    "Natural language visual editing",
    "Custom font and color theming",
  ],
  screenshot: {
    "@type": "ImageObject",
    url: `${siteConfig.url}/app-editor.png`,
    width: 1920,
    height: 1080,
  },
  author: {
    "@id": `${siteConfig.url}/#organization`,
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    description: "Free Starter plan with 5 videos/month at 720p",
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};

// Build breadcrumb from current URL path
const pathSegments = Astro.url.pathname.replace(/\/$/, "").split("/").filter(Boolean);
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.url },
  ...pathSegments.map((segment, i) => ({
    "@type": "ListItem" as const,
    position: i + 2,
    name: segment.charAt(0).toUpperCase() + segment.slice(1),
    item: `${siteConfig.url}/${pathSegments.slice(0, i + 1).join("/")}/`,
  })),
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems,
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${Astro.url.href}#webpage`,
  url: Astro.url.href,
  name: siteConfig.title,
  description: siteConfig.description,
  isPartOf: { "@id": `${siteConfig.url}/#website` },
  about: { "@id": `${siteConfig.url}/#software` },
  publisher: { "@id": `${siteConfig.url}/#organization` },
};

const schemas: Record<string, object> = {
  WebSite: websiteSchema,
  Organization: organizationSchema,
  SoftwareApplication: softwareSchema,
  FAQPage: faqSchema,
  WebPage: webPageSchema,
  BreadcrumbList: breadcrumbSchema,
};

const schema = schemas[type];
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

---
import { cn } from "@/lib/utils";

interface Props {
  variant?: "elevated" | "flat" | "bordered" | "gradient";
  hover?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  variant = "elevated",
  hover = true,
  class: className,
  ...props
} = Astro.props;

const baseStyles = "rounded-2xl p-6 lg:p-8";

const variants = {
  elevated: "bg-card border border-border shadow-md",
  flat: "bg-muted",
  bordered: "bg-card border-2 border-border",
  gradient: "border-gradient bg-card p-[2px]",
};

const hoverStyles = hover ? "hover:shadow-lg hover:-translate-y-1 transition-all duration-300" : "";
---

<div class={cn(baseStyles, variants[variant], hoverStyles, className)} {...props}>
  {variant === "gradient" ? (
    <div class="bg-card rounded-[14px] p-6 lg:p-8 h-full">
      <slot />
    </div>
  ) : (
    <slot />
  )}
</div>

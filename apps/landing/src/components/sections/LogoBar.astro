---
import Container from "@/components/ui/Container.astro";
---

<section class="py-12 border-y border-border/30">
  <Container>
    <p class="text-center text-sm text-muted-foreground mb-8">
      Trusted by creators and teams at
    </p>
    <div class="flex flex-wrap items-center justify-center gap-8 md:gap-16 opacity-60">
      <!-- Placeholder logos - replace with actual client logos -->
      {["TechFlow", "CreatorStudio", "MediaPro", "PixelPerfect", "Streamline"].map((name) => (
        <div class="text-lg font-semibold text-muted-foreground">
          {name}
        </div>
      ))}
    </div>
  </Container>
</section>

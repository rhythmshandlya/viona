---
import Container from "@/components/ui/Container.astro";

const steps = [
  {
    number: "01",
    title: "Describe Your Vision",
    description: "Tell our AI what you want to create. Describe the mood, style, and content of your video in natural language.",
  },
  {
    number: "02",
    title: "AI Generates Your Video",
    description: "Our advanced AI processes your prompt and generates a stunning video complete with visuals, transitions, and effects.",
  },
  {
    number: "03",
    title: "Customize & Refine",
    description: "Use our intuitive editor to fine-tune every detail. Adjust timing, add music, or tweak the style to perfection.",
  },
  {
    number: "04",
    title: "Export & Share",
    description: "Download your video in any format or share directly to social media platforms with one click.",
  },
];
---

<section id="how-it-works" class="py-24 lg:py-32 relative">
  <!-- Background accent -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-primary/5 to-transparent pointer-events-none"></div>

  <Container>
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="animate-on-scroll text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
        From idea to video in
        <span class="text-gradient">four simple steps</span>
      </h2>
      <p class="animate-on-scroll text-lg text-muted-foreground" style="animation-delay: 0.1s;">
        No complex software to learn. No hours of editing. Just describe what you want and let AI do the rest.
      </p>
    </div>

    <!-- Steps -->
    <div class="relative max-w-4xl mx-auto">
      <!-- Connecting line -->
      <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-primary/50 via-secondary/50 to-accent/50 hidden sm:block"></div>

      <div class="space-y-12 md:space-y-16">
        {steps.map((step, index) => (
          <div class={`animate-on-scroll relative flex flex-col md:flex-row items-start gap-6 md:gap-12 ${index % 2 === 1 ? 'md:flex-row-reverse' : ''}`} style={`animation-delay: ${index * 0.15}s;`}>
            <!-- Number bubble -->
            <div class="flex-shrink-0 relative z-10">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-primary to-secondary flex items-center justify-center text-primary-foreground font-bold text-xl shadow-lg glow-primary">
                {step.number}
              </div>
            </div>

            <!-- Content -->
            <div class={`flex-1 ${index % 2 === 1 ? 'md:text-right' : ''}`}>
              <h3 class="text-2xl font-semibold mb-2">{step.title}</h3>
              <p class="text-muted-foreground max-w-md">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>

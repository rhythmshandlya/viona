---
const steps = [
  {
    number: "1",
    title: "Describe your vision",
    description: "Tell our AI what you want to create using natural language.",
  },
  {
    number: "2",
    title: "AI generates your video",
    description: "Our AI processes your prompt and creates a video with visuals and effects.",
  },
  {
    number: "3",
    title: "Customize and refine",
    description: "Fine-tune every detail with our intuitive editor.",
  },
  {
    number: "4",
    title: "Export and share",
    description: "Download in any format or share directly to social media.",
  },
];
---

<section id="how-it-works" class="py-20 lg:py-28 bg-muted">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mb-16">
      <h2 class="animate-on-scroll text-3xl sm:text-4xl font-semibold tracking-tight mb-4">
        How it works
      </h2>
      <p class="animate-on-scroll text-muted-foreground" style="animation-delay: 0.05s;">
        From idea to video in four simple steps.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 stagger-children">
      {steps.map((step) => (
        <div class="space-y-3">
          <div class="text-sm text-muted-foreground">{step.number}</div>
          <h3 class="font-medium">{step.title}</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

---
import { siteConfig } from "@/data/site";
---

<section class="py-20 lg:py-28 bg-foreground text-background">
  <div class="max-w-2xl mx-auto px-6 text-center">
    <h2 class="animate-on-scroll text-3xl sm:text-4xl font-semibold tracking-tight mb-4">
      Ready to start?
    </h2>
    <p class="animate-on-scroll text-background/70 mb-8" style="animation-delay: 0.05s;">
      Join thousands of creators making videos with AI.
    </p>
    <a
      href={siteConfig.appUrl}
      class="animate-on-scroll inline-block text-sm font-medium bg-background text-foreground px-6 py-3 rounded-md hover:opacity-90 transition-opacity"
      style="animation-delay: 0.1s;"
    >
      Start Creating — Free
    </a>
  </div>
</section>

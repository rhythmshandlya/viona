---
import { siteConfig } from "@/data/site";
---

<section class="py-12 sm:py-16 lg:py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="glass-surface rounded-2xl sm:rounded-3xl px-4 sm:px-8 py-10 sm:py-16 text-center relative overflow-hidden">
      <!-- Decorative dots - hidden on mobile -->
      <div class="hidden sm:block absolute top-8 right-8">
        <div data-cta-dot class="w-3 h-3 bg-primary rounded-full"></div>
      </div>
      <div class="hidden sm:block absolute bottom-8 left-8">
        <div data-cta-dot class="w-3 h-3 bg-primary rounded-full"></div>
      </div>

      <h2 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-semibold text-white mb-3 sm:mb-4 px-2">
        Stop Spending Hours on Editing
      </h2>
      <p class="text-sm sm:text-base text-white/60 mb-6 sm:mb-8 max-w-md mx-auto px-2">
        Upload your video and let AI generate the visuals. Try it free—no credit card required.
      </p>

      <a data-cta-button href="#waitlist-form" class="inline-flex items-center gap-2 bg-primary text-white px-5 sm:px-6 py-2.5 sm:py-3 rounded-xl font-medium text-sm sm:text-base hover:bg-primary/90" style="box-shadow: 0 2px 12px rgba(139,92,246,0.35), inset 0 1px 0 rgba(255,255,255,0.15);">
        Join Waitlist
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from "@/scripts/animations";

  document.addEventListener("astro:page-load", () => {
    // Continuous: decorative dots float
    gsap.to('[data-cta-dot]', {
      y: -8,
      duration: 2,
      ease: "sine.inOut",
      repeat: -1,
      yoyo: true,
      stagger: 0.5,
    });

    // Read --color-primary from CSS and build rgba string for GSAP
    const primary = getComputedStyle(document.documentElement).getPropertyValue("--color-primary").trim();
    const hex = primary.replace("#", "");
    const r = parseInt(hex.substring(0, 2), 16);
    const g = parseInt(hex.substring(2, 4), 16);
    const b = parseInt(hex.substring(4, 6), 16);

    // Continuous: button glow pulse
    gsap.to('[data-cta-button]', {
      boxShadow: "0 0 20px rgba(124, 58, 237, 0.4)",
      duration: 1.5,
      ease: "sine.inOut",
      repeat: -1,
      yoyo: true,
    });
  });
</script>

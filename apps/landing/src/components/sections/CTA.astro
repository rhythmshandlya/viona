---
import { siteConfig } from "@/data/site";
---

<section class="py-12 sm:py-16 lg:py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="bg-dark rounded-2xl sm:rounded-3xl px-4 sm:px-8 py-10 sm:py-16 text-center relative overflow-hidden">
      <!-- Decorative dots - hidden on mobile -->
      <div class="hidden sm:block absolute top-8 right-8">
        <div class="w-3 h-3 bg-primary rounded-full"></div>
      </div>
      <div class="hidden sm:block absolute bottom-8 left-8">
        <div class="w-3 h-3 bg-primary rounded-full"></div>
      </div>

      <h2 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-semibold text-white mb-3 sm:mb-4 px-2">
        Stop Spending Hours on Editing
      </h2>
      <p class="text-sm sm:text-base text-white/60 mb-6 sm:mb-8 max-w-md mx-auto px-2">
        Upload your video and let AI generate the visuals. Try it free—no credit card required.
      </p>

      <a href={siteConfig.appUrl} class="inline-flex items-center gap-2 bg-primary text-white px-5 sm:px-6 py-2.5 sm:py-3 rounded-lg font-medium text-sm sm:text-base hover:bg-primary/90">
        Start Creating Free
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>

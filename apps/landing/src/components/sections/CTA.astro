---
import { siteConfig } from "@/data/site";
---

<section class="py-20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="bg-dark rounded-3xl px-8 py-16 text-center relative overflow-hidden">
      <!-- Decorative dots -->
      <div class="absolute top-8 right-8">
        <div class="w-3 h-3 bg-primary rounded-full"></div>
      </div>
      <div class="absolute bottom-8 left-8">
        <div class="w-3 h-3 bg-primary rounded-full"></div>
      </div>

      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-white mb-4">
        Stop Spending Hours on Editing
      </h2>
      <p class="text-white/60 mb-8 max-w-md mx-auto">
        Upload your video and let AI generate the visuals. Try it free—no credit card required.
      </p>

      <a href={siteConfig.appUrl} class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary/90">
        Start Creating Free
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>

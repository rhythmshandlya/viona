---
import { siteConfig } from "@/data/site";
---

<section class="relative pt-28 pb-16 lg:pt-32 lg:pb-20 overflow-hidden">
  <!-- Orange gradient blob -->
  <div class="hero-gradient"></div>

  <div class="max-w-6xl mx-auto px-6 relative z-10">
    <!-- Tagline badge -->
    <div class="flex justify-center mb-8">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-border bg-white text-sm">
        <span class="text-muted-foreground">For explainer videos & courses</span>
      </div>
    </div>

    <!-- Headline -->
    <div class="text-center mb-6">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight leading-tight">
        You Explain It.
        <br />Cllipify <span class="wavy-underline">Illustrates</span> It.
      </h1>
    </div>

    <!-- Subheadline -->
    <p class="text-center text-muted-foreground max-w-xl mx-auto mb-10">
      Upload your talking-head video. Our AI transcribes it, removes filler words,
      and generates charts, diagrams, and graphics synced to your explanations.
    </p>

    <!-- CTA Button -->
    <div class="flex justify-center mb-16">
      <a href={siteConfig.appUrl} class="btn-primary">
        Start Creating Free
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <!-- Before/After Visual -->
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center justify-center gap-3 sm:gap-6">
        <!-- Before -->
        <div class="text-center flex-1">
          <div class="bg-white rounded-2xl border border-gray-200 p-4 sm:p-6 shadow-sm mb-3">
            <div class="aspect-video bg-gray-100 rounded-xl flex items-center justify-center">
              <!-- Person icon -->
              <svg class="w-16 h-16 sm:w-20 sm:h-20 text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
              </svg>
            </div>
          </div>
          <span class="text-sm text-muted-foreground">Your talking-head video</span>
        </div>

        <!-- Arrow -->
        <div class="flex-shrink-0">
          <div class="w-10 h-10 sm:w-12 sm:h-12 bg-primary/10 rounded-full flex items-center justify-center">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </div>
        </div>

        <!-- After -->
        <div class="text-center flex-1">
          <div class="bg-white rounded-2xl border border-gray-200 p-4 sm:p-6 shadow-sm mb-3 ring-2 ring-primary/20">
            <div class="aspect-video bg-white rounded-xl relative overflow-hidden border border-gray-100">
              <!-- Main visual area with chart -->
              <div class="absolute inset-2 sm:inset-3 right-14 sm:right-16 bg-gray-50 rounded-lg p-2 sm:p-3 flex flex-col">
                <div class="text-[9px] sm:text-xs font-semibold text-gray-700 mb-2">Growth Rate</div>
                <!-- Bar chart -->
                <div class="flex-1 flex items-end gap-1.5 sm:gap-2">
                  <div class="flex-1 bg-primary/30 rounded-t h-[30%]"></div>
                  <div class="flex-1 bg-primary/50 rounded-t h-[55%]"></div>
                  <div class="flex-1 bg-primary/70 rounded-t h-[45%]"></div>
                  <div class="flex-1 bg-primary rounded-t h-[80%]"></div>
                </div>
              </div>
              <!-- PiP -->
              <div class="absolute bottom-2 right-2 w-10 h-10 sm:w-12 sm:h-12 bg-gray-100 rounded-lg border border-gray-200 flex items-center justify-center">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
              </div>
            </div>
          </div>
          <span class="text-sm text-muted-foreground">With AI-generated visuals</span>
        </div>
      </div>
    </div>
  </div>
</section>

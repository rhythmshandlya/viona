---
import { siteConfig } from "@/data/site";
---

<section class="pt-32 pb-20 lg:pt-40 lg:pb-28">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <p class="animate-on-scroll text-sm text-muted-foreground mb-6">
      AI-Powered Video Generation
    </p>

    <h1 class="animate-on-scroll text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight mb-6" style="animation-delay: 0.05s;">
      Create videos from text in seconds
    </h1>

    <p class="animate-on-scroll text-lg text-muted-foreground max-w-xl mx-auto mb-10" style="animation-delay: 0.1s;">
      Describe what you want, and our AI generates professional videos. No editing skills required.
    </p>

    <div class="animate-on-scroll flex flex-col sm:flex-row items-center justify-center gap-4" style="animation-delay: 0.15s;">
      <a
        href={siteConfig.appUrl}
        class="w-full sm:w-auto text-sm font-medium bg-foreground text-background px-6 py-3 rounded-md hover:opacity-90 transition-opacity"
      >
        Start Creating — Free
      </a>
      <a
        href="#how-it-works"
        class="w-full sm:w-auto text-sm font-medium text-foreground px-6 py-3 rounded-md border border-border hover:bg-muted transition-colors"
      >
        See How It Works
      </a>
    </div>
  </div>
</section>

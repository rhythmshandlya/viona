---
import { siteConfig } from "@/data/site";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
---

<section class="relative pt-32 pb-20 lg:pt-40 lg:pb-32 overflow-hidden">
  <!-- Floating Orbs -->
  <div class="floating-orb w-96 h-96 bg-primary/20 top-20 -left-48 animate-float" style="animation-delay: 0s;"></div>
  <div class="floating-orb w-80 h-80 bg-secondary/20 top-40 -right-40 animate-float" style="animation-delay: 2s;"></div>
  <div class="floating-orb w-64 h-64 bg-accent/15 bottom-20 left-1/4 animate-float" style="animation-delay: 4s;"></div>

  <Container>
    <div class="relative z-10 text-center max-w-4xl mx-auto">
      <!-- Badge -->
      <div class="animate-on-scroll mb-6">
        <Badge variant="primary">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
          </span>
          Now in Public Beta
        </Badge>
      </div>

      <!-- Headline -->
      <h1 class="animate-on-scroll text-4xl sm:text-5xl lg:text-7xl font-bold tracking-tight mb-6" style="animation-delay: 0.1s;">
        <span class="block">Transform Your Ideas</span>
        <span class="block text-gradient-hero">Into Stunning Videos</span>
      </h1>

      <!-- Subheadline -->
      <p class="animate-on-scroll text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto mb-10" style="animation-delay: 0.2s;">
        AI-powered video generation for the next generation of creators.
        Create professional videos in minutes, not hours.
      </p>

      <!-- CTA Buttons -->
      <div class="animate-on-scroll flex flex-col sm:flex-row items-center justify-center gap-4 mb-16" style="animation-delay: 0.3s;">
        <Button href={siteConfig.appUrl} size="lg" glow>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3l14 9-14 9V3z" />
          </svg>
          Start Creating Free
        </Button>
        <Button href="#how-it-works" variant="outline" size="lg">
          Watch Demo
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </Button>
      </div>

      <!-- Product Preview -->
      <div class="animate-on-scroll relative" style="animation-delay: 0.4s;">
        <!-- Glow behind preview -->
        <div class="absolute inset-0 bg-gradient-to-r from-primary/20 via-secondary/20 to-accent/20 blur-3xl rounded-3xl transform scale-95"></div>

        <!-- Glass card with preview -->
        <div class="relative glass-card rounded-2xl p-2 sm:p-3">
          <div class="relative aspect-video rounded-xl overflow-hidden bg-background/50">
            <!-- Placeholder for product demo/screenshot -->
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center">
                <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-primary/10 flex items-center justify-center">
                  <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <p class="text-muted-foreground text-sm">Product Preview</p>
              </div>
            </div>

            <!-- Floating UI elements -->
            <div class="absolute top-4 left-4 glass rounded-lg px-3 py-2 text-xs font-medium animate-float" style="animation-delay: 1s;">
              <span class="text-primary">AI</span> Processing...
            </div>
            <div class="absolute bottom-4 right-4 glass rounded-lg px-3 py-2 text-xs font-medium animate-float" style="animation-delay: 2s;">
              <span class="text-green-400">4K</span> Ready
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

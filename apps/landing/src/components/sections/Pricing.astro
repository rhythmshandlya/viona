---
import { pricingTiers } from "@/data/pricing";
import { siteConfig } from "@/data/site";
---

<section id="pricing" class="py-20 lg:py-28 bg-muted">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mb-16">
      <h2 class="animate-on-scroll text-3xl sm:text-4xl font-semibold tracking-tight mb-4">
        Simple pricing
      </h2>
      <p class="animate-on-scroll text-muted-foreground" style="animation-delay: 0.05s;">
        Start free and scale as you grow.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-4xl stagger-children">
      {pricingTiers.map((tier) => (
        <div class={`bg-background p-8 rounded-lg ${tier.popular ? 'ring-1 ring-foreground' : 'border border-border'}`}>
          <div class="mb-6">
            <h3 class="font-medium mb-2">{tier.name}</h3>
            <div class="flex items-baseline gap-1 mb-2">
              <span class="text-3xl font-semibold">{tier.price}</span>
              <span class="text-sm text-muted-foreground">/{tier.period}</span>
            </div>
            <p class="text-sm text-muted-foreground">{tier.description}</p>
          </div>

          <ul class="space-y-3 mb-8">
            {tier.features.map((feature) => (
              <li class="text-sm text-muted-foreground flex items-start gap-2">
                <span class="text-foreground">✓</span>
                {feature}
              </li>
            ))}
          </ul>

          <a
            href={siteConfig.appUrl}
            class={`block text-center text-sm font-medium px-4 py-2.5 rounded-md transition-colors ${
              tier.popular
                ? 'bg-foreground text-background hover:opacity-90'
                : 'border border-border hover:bg-muted'
            }`}
          >
            {tier.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

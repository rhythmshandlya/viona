---
---

<section class="py-12 sm:py-16 bg-dark">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Value proposition header -->
    <div class="flex flex-col md:flex-row md:items-center gap-4 sm:gap-6 mb-8 sm:mb-12">
      <div class="md:flex-1">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold leading-tight text-white">
          Stop Editing.
          <br />Start <span class="text-primary">Creating</span>.
        </h2>
      </div>
      <div class="md:flex-1">
        <p class="text-sm sm:text-base text-white/50 md:max-w-md">
          Other tools make videos look better. Viona makes ideas clearer.
          AI-generated visuals that actually match what you're explaining.
        </p>
      </div>
    </div>

    <!-- Stats bar -->
    <div class="stats-bar">
      <div class="stats-grid">
        <!-- Stat 1 -->
        <div class="stat-item">
          <div class="stat-value">4hrs</div>
          <p class="stat-label">Average editing time saved per video</p>
        </div>

        <!-- Divider -->
        <div class="stat-divider"></div>

        <!-- Stat 2 -->
        <div class="stat-item">
          <div class="stat-value">95%</div>
          <p class="stat-label">Transcription accuracy</p>
        </div>

        <!-- Divider -->
        <div class="stat-divider"></div>

        <!-- Stat 3 -->
        <div class="stat-item">
          <div class="stat-value">15+</div>
          <p class="stat-label">Subtitle animation presets available</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .stats-bar {
    position: relative;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 1.5rem;
    padding: 2rem 1.5rem;
    -webkit-backdrop-filter: blur(40px) saturate(200%);
    backdrop-filter: blur(40px) saturate(200%);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }

  .stats-bar::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.06) 0%, transparent 50%);
    border-radius: inherit;
    pointer-events: none;
  }

  .stats-grid {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .stats-grid {
      flex-direction: row;
      align-items: center;
      gap: 0;
    }

    .stats-bar {
      padding: 2.5rem 2rem;
    }
  }

  .stat-item {
    flex: 1;
    text-align: center;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.1;
    margin-bottom: 0.35rem;
  }

  @media (min-width: 640px) {
    .stat-value { font-size: 2.5rem; }
  }

  @media (min-width: 768px) {
    .stat-value { font-size: 3rem; }
  }

  .stat-label {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    max-width: 180px;
    margin: 0 auto;
    line-height: 1.4;
  }

  @media (min-width: 640px) {
    .stat-label { font-size: 0.8125rem; }
  }

  .stat-divider {
    display: none;
  }

  @media (min-width: 640px) {
    .stat-divider {
      display: block;
      width: 1px;
      height: 48px;
      background: rgba(255, 255, 255, 0.08);
      flex-shrink: 0;
    }
  }
</style>

---

<section class="py-16">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Value proposition header -->
    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <div>
        <h2 class="text-3xl sm:text-4xl font-semibold leading-tight">
          Stop Editing.
          <br />Start <span class="text-orange">Creating</span>.
        </h2>
      </div>
      <div class="flex items-center">
        <p class="text-muted-foreground">
          Other tools make videos look better. Cllipify makes ideas clearer.
          AI-generated visuals that actually match what you're explaining.
        </p>
      </div>
    </div>

    <!-- Dark stats bar -->
    <div class="bg-dark rounded-2xl px-8 py-10">
      <div class="grid grid-cols-3 gap-8">
        <!-- Stat 1 -->
        <div class="text-center text-white">
          <div class="text-4xl sm:text-5xl font-semibold mb-2">4hrs</div>
          <p class="text-sm text-white/60">Average editing time<br />saved per video</p>
        </div>

        <!-- Sparkle divider -->
        <div class="hidden sm:flex items-center justify-center">
          <div class="flex items-center gap-8 w-full justify-center">
            <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
            </svg>
            <div class="text-center text-white">
              <div class="text-4xl sm:text-5xl font-semibold mb-2">95%</div>
              <p class="text-sm text-white/60">Transcription<br />accuracy</p>
            </div>
            <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
            </svg>
          </div>
        </div>

        <!-- Stat 3 -->
        <div class="text-center text-white">
          <div class="text-4xl sm:text-5xl font-semibold mb-2">15+</div>
          <p class="text-sm text-white/60">Subtitle animation<br />presets available</p>
        </div>
      </div>
    </div>
  </div>
</section>

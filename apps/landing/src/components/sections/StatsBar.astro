---
---

<section class="py-12 sm:py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Value proposition header -->
    <div class="grid md:grid-cols-2 gap-6 sm:gap-8 mb-8 sm:mb-12">
      <div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold leading-tight">
          Stop Editing.
          <br />Start <span class="text-orange">Creating</span>.
        </h2>
      </div>
      <div class="flex items-center">
        <p class="text-sm sm:text-base text-muted-foreground">
          Other tools make videos look better. Cllipify makes ideas clearer.
          AI-generated visuals that actually match what you're explaining.
        </p>
      </div>
    </div>

    <!-- Dark stats bar -->
    <div class="bg-dark rounded-2xl px-4 sm:px-6 md:px-8 py-8 sm:py-10">
      <!-- Mobile: Stack, Desktop: Row -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-4 md:gap-8">
        <!-- Stat 1 -->
        <div class="text-center text-white">
          <div class="text-3xl sm:text-4xl md:text-5xl font-semibold mb-1 sm:mb-2">4hrs</div>
          <p class="text-xs sm:text-sm text-white/60">Average editing time saved per video</p>
        </div>

        <!-- Stat 2 (with sparkles on desktop) -->
        <div class="text-center text-white relative">
          <div class="hidden sm:block absolute left-0 top-1/2 -translate-y-1/2">
            <svg class="w-4 md:w-6 h-4 md:h-6 text-primary" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
            </svg>
          </div>
          <div class="text-3xl sm:text-4xl md:text-5xl font-semibold mb-1 sm:mb-2">95%</div>
          <p class="text-xs sm:text-sm text-white/60">Transcription accuracy</p>
          <div class="hidden sm:block absolute right-0 top-1/2 -translate-y-1/2">
            <svg class="w-4 md:w-6 h-4 md:h-6 text-primary" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
            </svg>
          </div>
        </div>

        <!-- Stat 3 -->
        <div class="text-center text-white">
          <div class="text-3xl sm:text-4xl md:text-5xl font-semibold mb-1 sm:mb-2">15+</div>
          <p class="text-xs sm:text-sm text-white/60">Subtitle animation presets available</p>
        </div>
      </div>
    </div>
  </div>
</section>

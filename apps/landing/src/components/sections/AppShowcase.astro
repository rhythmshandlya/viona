    box-shadow: 0 0 6px rgba(16,185,129,0.4);
  }

  /* ══════════════════════════════
     RESPONSIVE
  ══════════════════════════════ */

  /* Tablet: hide sidebar + icon rail */
  @media (max-width: 1023px) {
    .me-icon-rail,
    .me-sidebar {
      display: none !important;
    }
  }

  /* Mobile: also hide track headers */
  @media (max-width: 767px) {
    .me-track-header {
      display: none;
    }
    .me-ruler-headers {
      display: none;
    }
    .me-playhead {
      left: 0;
    }
    .me-header-title {
      font-size: 11px;
    }
    .me-export-btn {
      font-size: 10px;
      padding: 4px 10px;
    }
    .mock-editor {
      aspect-ratio: 4 / 3;
    }
  }
</style>

<script>
  import { gsap } from "@/scripts/animations";

  document.addEventListener("astro:page-load", () => {
    const section = document
      .querySelector("[data-showcase-heading]")
      ?.closest("section");
    if (!section) return;

    /* ── Entrance animation ── */
    gsap.set("[data-showcase-heading]", { opacity: 0, y: 30 });
    gsap.set("[data-showcase-sub]", { opacity: 0, y: 20 });
    gsap.set("[data-showcase-front]", { opacity: 0, y: 50 });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.disconnect();

          const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
          tl.to("[data-showcase-heading]", { y: 0, opacity: 1, duration: 0.7 })
            .to("[data-showcase-sub]", { y: 0, opacity: 1, duration: 0.5 }, "-=0.4")
            .to("[data-showcase-front]", { y: 0, opacity: 1, duration: 1 }, "-=0.2");
        });
      },
      { threshold: 0.1 }
    );
    observer.observe(section);

    /* ── Elements ── */
    const videoBefore = document.querySelector<HTMLVideoElement>("[data-video-before]");
    const videoAfter = document.querySelector<HTMLVideoElement>("[data-video-after]");
    const generateBtn = document.querySelector<HTMLButtonElement>("[data-generate-btn]");
    const generateLabel = document.querySelector<HTMLSpanElement>("[data-generate-label]");
    const chatStatusText = document.querySelector<HTMLSpanElement>("[data-chat-status-text]");
    const chatDoneMsg = document.querySelector<HTMLDivElement>("[data-chat-done]");
    const fakeCursor = document.querySelector<HTMLDivElement>("[data-fake-cursor]");
    const mockEditor = document.querySelector<HTMLDivElement>(".me-main");
    const playBtn = document.querySelector<HTMLButtonElement>('[data-ctrl="playpause"]');
    const skipBackBtn = document.querySelector<HTMLButtonElement>('[data-ctrl="skipback"]');
    const skipFwdBtn = document.querySelector<HTMLButtonElement>('[data-ctrl="skipfwd"]');
    const playIcon = document.querySelector<SVGElement>("[data-play-icon]");
    const pauseIcon = document.querySelector<SVGElement>("[data-pause-icon]");
    const timeDisplay = document.querySelector<HTMLSpanElement>("[data-time-display]");
    const playhead = document.querySelector<HTMLDivElement>("[data-playhead]");
    const sidebar = document.querySelector<HTMLDivElement>("[data-sidebar]");
    const sidebarTitle = document.querySelector<HTMLSpanElement>("[data-sidebar-title]");
    const sidebarCloseBtn = document.querySelector<HTMLButtonElement>("[data-sidebar-close]");
    const railBtns = document.querySelectorAll<HTMLButtonElement>("[data-rail-btn]");
    const sidebarContents = document.querySelectorAll<HTMLDivElement>("[data-sidebar-content]");

    // The "active" video for play/pause controls — starts as before, swaps to after
    let video = videoBefore;
    if (!video || !playBtn || !playhead) return;

    /* ── Generate transformation flow (triggered by click) ── */
    let generateTriggered = false;

    function triggerGenerate() {
      if (generateTriggered || !generateBtn || !videoBefore || !videoAfter || !generateLabel) return;
      generateTriggered = true;

      // Loading state
      generateBtn.classList.add("is-loading");
      const btnIcon = generateBtn.querySelector("svg");
      if (btnIcon) btnIcon.style.display = "none";
      generateLabel.innerHTML = '<span class="me-gen-spinner"></span> Generating…';
      if (chatStatusText) chatStatusText.textContent = "Enhancing your video…";

      // After 3s: crossfade to after video
      setTimeout(() => {
        videoBefore.classList.add("me-video-full--hidden");
        videoAfter.classList.remove("me-video-full--hidden");
        videoAfter.play();

        video = videoAfter;

        generateBtn.classList.remove("is-loading");
        generateBtn.classList.add("is-done");
        generateLabel.textContent = "Done";
        if (chatStatusText) chatStatusText.textContent = "Your enhanced video is ready!";

        if (chatDoneMsg) {
          chatDoneMsg.style.display = "";
          gsap.from(chatDoneMsg, { opacity: 0, y: 8, duration: 0.4, ease: "power2.out" });
        }

        // Fade out cursor after done
        if (fakeCursor) {
          gsap.to(fakeCursor, { opacity: 0, duration: 0.4, delay: 0.5 });
        }
      }, 3000);
    }

    // Manual click also works
    if (generateBtn) {
      generateBtn.addEventListener("click", triggerGenerate);
    }

    /* ── Auto-play: cursor arrow flies to Generate button after 3s ── */
    if (fakeCursor && generateBtn && mockEditor) {
      setTimeout(() => {
        if (generateTriggered) return;

        const editorRect = mockEditor.getBoundingClientRect();
        const btnRect = generateBtn.getBoundingClientRect();

        // Position cursor relative to .me-main
        const startX = editorRect.width * 0.6;
        const startY = editorRect.height * 0.3;
        const endX = btnRect.left - editorRect.left + btnRect.width / 2;
        const endY = btnRect.top - editorRect.top + btnRect.height / 2;

        // Set start position
        gsap.set(fakeCursor, { x: startX, y: startY });

        // Animate: fade in → glide to button → click
        const cursorTl = gsap.timeline();
        cursorTl
          .to(fakeCursor, { opacity: 1, duration: 0.3, ease: "power2.out" })
          .to(fakeCursor, {
            x: endX,
            y: endY,
            duration: 0.8,
            ease: "power2.inOut",
          })
          .to(fakeCursor, {
            scale: 0.85,
            duration: 0.1,
            ease: "power2.in",
            onComplete: () => {
              // Trigger the generate
              triggerGenerate();
            },
          })
          .to(fakeCursor, {
            scale: 1,
            duration: 0.15,
            ease: "power2.out",
          });
      }, 3000);
    }

    /* ── Video play/pause ── */
    let isPlaying = false;

    function updatePlayIcons() {
      if (playIcon) playIcon.style.display = isPlaying ? "none" : "block";
      if (pauseIcon) pauseIcon.style.display = isPlaying ? "block" : "none";
    }

    playBtn.addEventListener("click", () => {
      if (!video) return;
      if (isPlaying) {
        video.pause();
      } else {
        video.play();
      }
      isPlaying = !isPlaying;
      updatePlayIcons();
    });

    skipBackBtn?.addEventListener("click", () => {
      if (!video) return;
      video.currentTime = Math.max(0, video.currentTime - 5);
    });

    skipFwdBtn?.addEventListener("click", () => {
      if (!video) return;
      video.currentTime = Math.min(video.duration || 0, video.currentTime + 5);
    });

    /* ── Format time ── */
    function formatTime(seconds: number): string {
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
    }

    /* ── Playhead sync + time display ── */
    // Check if track headers are visible (desktop) to determine playhead base offset
    function getPlayheadBasePercent(): number {
      const trackHeader = document.querySelector<HTMLDivElement>(".me-track-header");
      if (trackHeader && trackHeader.offsetParent !== null && trackHeader.offsetWidth > 0) {
        return 25; // 25% width for headers
      }
      return 0;
    }

    function tick() {
      if (!video || !playhead) { requestAnimationFrame(tick); return; }
      if (!video.duration) { requestAnimationFrame(tick); return; }

      const progress = video.currentTime / video.duration;
      const basePercent = getPlayheadBasePercent();
      const trackPercent = (1 - basePercent / 100) * 100;
      const leftPercent = basePercent + progress * trackPercent;
      playhead.style.left = `${leftPercent}%`;

      if (timeDisplay) {
        timeDisplay.textContent = `${formatTime(video.currentTime)} / ${formatTime(video.duration)}`;
      }

      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);

    /* ── Sidebar tab switching ── */
    const tabLabels: Record<string, string> = {
      chat: "AI Chat",
      captions: "Captions",
      style: "Style",
      assets: "Assets",
    };

    let activeTab = "chat";
    let sidebarOpen = true;

    function showSidebar(tab: string) {
      activeTab = tab;
      sidebarOpen = true;

      // Update rail buttons
      railBtns.forEach((btn) => {
        btn.classList.toggle("me-rail-btn--active", btn.dataset.railBtn === tab);
      });

      // Update sidebar content
      sidebarContents.forEach((content) => {
        content.classList.toggle(
          "me-sidebar-content--active",
          content.dataset.sidebarContent === tab
        );
      });

      // Update title
      if (sidebarTitle) sidebarTitle.textContent = tabLabels[tab] || tab;

      // Animate open
      if (sidebar) {
        sidebar.classList.remove("me-sidebar--closed");
      }
    }

    function closeSidebar() {
      sidebarOpen = false;
      railBtns.forEach((btn) => btn.classList.remove("me-rail-btn--active"));
      if (sidebar) {
        sidebar.classList.add("me-sidebar--closed");
      }
    }

    railBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const tab = btn.dataset.railBtn;
        if (!tab) return;

        if (sidebarOpen && activeTab === tab) {
          closeSidebar();
        } else {
          showSidebar(tab);
        }
      });
    });

    sidebarCloseBtn?.addEventListener("click", closeSidebar);
  });
</script>

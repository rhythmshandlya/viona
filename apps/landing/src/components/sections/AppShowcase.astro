  /* ── Timeline panel ── */
  .me-timeline-panel {
    height: 30%;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255,255,255,0.10);
    border-top: 1px solid rgba(255,255,255,0.16);
    border-radius: 16px;
    backdrop-filter: blur(40px) saturate(200%);
    -webkit-backdrop-filter: blur(40px) saturate(200%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.10);
    overflow: hidden;
  }

  /* ── Ruler ── */
  .me-ruler {
    display: flex;
    height: 22px;
    flex-shrink: 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .me-ruler-headers {
    width: 25%;
    flex-shrink: 0;
  }

  .me-ruler-ticks {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 4px;
  }

  .me-ruler-ticks span {
    font-size: 8px;
    color: rgba(255,255,255,0.25);
    font-family: 'SF Mono', 'Cascadia Code', monospace;
    font-variant-numeric: tabular-nums;
  }

  /* ── Tracks ── */
  .me-tracks {
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
    min-height: 0;
  }

  .me-track {
    display: flex;
    flex: 1;
    border-bottom: 1px solid rgba(255,255,255,0.03);
  }

  .me-track-header {
    width: 25%;
    display: flex;
    align-items: center;
    padding: 0 10px;
    font-size: 9px;
    font-weight: 600;
    color: rgba(255,255,255,0.3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
    border-right: 1px solid rgba(255,255,255,0.04);
  }

  .me-track-body {
    flex: 1;
    position: relative;
    padding: 3px 0;
  }

  .me-clip {
    position: absolute;
    top: 3px;
    bottom: 3px;
    border-radius: 5px;
    border: 1px solid rgba(255,255,255,0.08);
    transition: opacity 0.15s;
  }
  .me-clip--video { background: rgba(59,130,246,0.45); }
  .me-clip--visuals { background: rgba(251,191,36,0.45); }
  .me-clip--captions { background: rgba(139,92,246,0.45); }
  .me-clip--audio { background: rgba(16,185,129,0.4); }

  /* ── Playhead ── */
  .me-playhead {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 25%;
    width: 2px;
    z-index: 5;
    pointer-events: none;
    transition: left 0.05s linear;
  }

  .me-playhead-head {
    width: 10px;
    height: 10px;
    background: #10B981;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    position: absolute;
    top: -2px;
    left: -4px;
  }

  .me-playhead-line {
    position: absolute;
    top: 8px;
    bottom: 0;
    left: 0;

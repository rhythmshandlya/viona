/* ─────────────────── Generate Visuals quick-action ─────────────────── */
.chat-quick { padding: 0 10px 8px; }
.gen-btn {
  width: 100%; display: flex; align-items: center; justify-content: center; gap: 5px;
  padding: 7px 12px; border-radius: 10px; border: none; cursor: pointer;
  font-size: 11px; font-weight: 500; color: rgba(167,139,250,0.85);
  background: rgba(139,92,246,0.10);
  border: 1px solid rgba(139,92,246,0.22);
  transition: all 120ms ease;
}
.gen-btn:hover { background: rgba(139,92,246,0.18); border-color: rgba(139,92,246,0.38); }
.gen-btn-pulse {
  background: rgba(139,92,246,0.28) !important;
  border-color: rgba(139,92,246,0.6) !important;
  color: #c4b5fd !important;
  box-shadow: 0 0 14px rgba(139,92,246,0.35);
}

/* ─────────────────── AI Cursor ─────────────────── */
.ai-cursor {
  position: absolute; pointer-events: none; z-index: 200;
  opacity: 0; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.6));
  will-change: transform, left, top;
}

/* ─────────────────── Section glass background ─────────────────── */
.sc-section {
  position: relative;
}

/* ─────────────────── Entrance ─────────────────── */
[data-sc-heading], [data-sc-sub], [data-sc-browser] { opacity: 0; }
</style>

<script>
  import { gsap } from "@/scripts/animations";

  document.addEventListener("astro:page-load", () => {
    const section = document.querySelector("[data-sc-heading]")?.closest("section");
    if (!section) return;

    // ── Helpers ──
    const wait = (ms: number) => new Promise<void>(res => setTimeout(res, ms));

    // ── Playhead + scrubber ──
    const DURATION = 32;
    const SPEED    = 14;
    const start    = performance.now();
    const playhead = document.getElementById("playhead");
    const pbFill   = document.getElementById("pb-fill");
    const pbKnob   = document.getElementById("pb-knob");
    const pbTime   = document.getElementById("pb-time");

    const fmt = (s: number) => {
      const m  = Math.floor(s / 60);
      const sc = Math.floor(s % 60);
      const cs = Math.floor((s % 1) * 100);
      return `${m}:${sc.toString().padStart(2,"0")}.${cs.toString().padStart(2,"0")}`;
    };
    const tick = () => {
      const pct  = ((performance.now() - start) / 1000 % SPEED) / SPEED * 100;
      const left = 6 + pct * 0.88;
      if (playhead) playhead.style.left = left + "%";
      if (pbFill)   pbFill.style.width  = pct + "%";
      if (pbKnob)   pbKnob.style.right  = (100 - pct) + "%";
      if (pbTime)   pbTime.textContent  = fmt((pct / 100) * DURATION);
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    // ── Icon rail interactivity ──
    const irBtns = document.querySelectorAll<HTMLElement>(".ir-btn");
    const panelMap: Record<string, string> = {
      "ir-chat":     "chat-panel",
      "ir-captions": "captions-panel",
      "ir-style":    "style-panel",
      "ir-assets":   "assets-panel",
    };
    irBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        irBtns.forEach(b => b.classList.remove("ir-active"));
        btn.classList.add("ir-active");
        // Hide all sidebar panels then show the matching one
        Object.values(panelMap).forEach(id => {
          const el = document.getElementById(id);
          if (el) el.classList.remove("sp-visible");
        });
        const target = document.getElementById(panelMap[btn.id] ?? "");
        if (target) target.classList.add("sp-visible");
      });
    });

    // ── Before/After video sequence ──
    const vidBefore = document.getElementById("vid-before")  as HTMLVideoElement;
    const vidAfter  = document.getElementById("vid-after")   as HTMLVideoElement;
    const badge     = document.getElementById("pv-badge")    as HTMLElement;
    const loading   = document.getElementById("pv-loading")  as HTMLElement;
    const cursor    = document.getElementById("ai-cursor")   as HTMLElement;
    const genBtn    = document.getElementById("gen-btn")     as HTMLElement;
    const shell     = document.querySelector(".browser-shell") as HTMLElement;

    // Reliable GSAP promise wrapper using onComplete
    const anim = (target: gsap.TweenTarget, vars: gsap.TweenVars) =>
      new Promise<void>(res => gsap.to(target, { ...vars, onComplete: res }));

    const runSequence = async () => {
      // ── Reset to "before" state ──
      gsap.set(cursor, { opacity: 0, x: 0, y: 0, scale: 1 });
      vidBefore.style.opacity  = "1";
      vidAfter.style.opacity   = "0";
      loading.style.opacity    = "0";
      badge.style.opacity      = "1";
      badge.innerHTML = '<span class="pv-dot pv-dot-raw"></span>Raw footage';
      genBtn.classList.remove("gen-btn-pulse");

      vidBefore.currentTime = 0;
      vidBefore.play().catch(() => {});

      // ── Phase 1: let before play for 3s then show cursor ──
      await wait(3000);

      // ── Phase 2: cursor slowly drifts to "Generate Visuals" ──
      const shellRect = shell.getBoundingClientRect();
      const btnRect   = genBtn.getBoundingClientRect();
      const sx = shellRect.width  * 0.62;
      const sy = shellRect.height * 0.42;
      const ex = btnRect.left - shellRect.left + 18;
      const ey = btnRect.top  - shellRect.top  + btnRect.height / 2;

      gsap.set(cursor, { x: sx, y: sy, opacity: 0, scale: 1 });
      await anim(cursor, { opacity: 1, duration: 0.5 });
      await anim(cursor, { x: ex, y: ey, duration: 2.2, ease: "power1.inOut" });
      await wait(200);

      // ── Phase 3: click ──
      await anim(cursor, { scale: 0.82, duration: 0.1 });
      genBtn.classList.add("gen-btn-pulse");
      vidBefore.pause();
      await anim(cursor, { scale: 1, duration: 0.1 });
      await wait(300);

      // ── Phase 4: loading overlay ──
      loading.style.opacity = "1";
      await anim(cursor, { opacity: 0, duration: 0.3 });
      await wait(1800);

      // ── Phase 5: reveal after ──
      loading.style.opacity    = "0";
      vidAfter.currentTime     = 0;
      vidAfter.play().catch(() => {});
      await wait(80); // let video start
      vidAfter.style.opacity   = "1";
      vidBefore.style.opacity  = "0";
      badge.innerHTML = '<span class="pv-dot pv-dot-ai"></span>AI Enhanced';

      // ── Phase 6: show after (12s) then loop back ──
      await wait(12000);
      vidAfter.pause();
      genBtn.classList.remove("gen-btn-pulse");
      // Fade back to before
      vidBefore.style.opacity = "1";
      vidBefore.currentTime   = 0;
      await anim(vidAfter, { opacity: 0, duration: 0.8 });
      await wait(800);
      runSequence();
    };

    // ── Entrance animation → then start sequence ──
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        obs.disconnect();
        gsap.set("[data-sc-heading]", { y: 30 });
        gsap.set("[data-sc-sub]",     { y: 20 });
        gsap.set("[data-sc-browser]", { y: 50, scale: 0.97 });
        const tl = gsap.timeline({
          defaults: { ease: "power3.out" },
          onComplete: runSequence,
        });
        tl.to("[data-sc-heading]", { opacity:1, y:0, duration:0.7 })
          .to("[data-sc-sub]",     { opacity:1, y:0, duration:0.5 }, "-=0.4")
          .to("[data-sc-browser]", { opacity:1, y:0, scale:1, duration:1 }, "-=0.3");
      });
    }, { threshold: 0.08 });
    obs.observe(section);
  });
</script>

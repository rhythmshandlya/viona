  /* ── Generate button in chat ── */
  .me-chat-generate-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 6px;
    padding: 4px 12px;
    border-radius: 8px;
    font-size: 10px;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, #8B5CF6, #7C3AED);
    border: none;
    cursor: pointer;
    box-shadow: 0 2px 10px rgba(139, 92, 246, 0.35), inset 0 1px 0 rgba(255,255,255,0.15);
    transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
    white-space: nowrap;
  }

  .me-chat-generate-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 3px 16px rgba(139, 92, 246, 0.5), inset 0 1px 0 rgba(255,255,255,0.15);
  }

  .me-chat-generate-btn:active {
    transform: scale(0.97);
  }

  .me-chat-generate-btn.is-loading {
    pointer-events: none;
    opacity: 0.7;
  }

  .me-chat-generate-btn.is-done {

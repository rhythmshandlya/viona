---
---

<section class="sc-section pt-16 sm:pt-20 lg:pt-28 pb-20 sm:pb-24 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">

    <div class="text-center mb-10 sm:mb-14">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-white mb-3 tracking-tight" data-sc-heading>
        Your AI Video Editor
      </h2>
      <p class="text-sm sm:text-base text-white/40 max-w-md mx-auto" data-sc-sub>
        Timeline, captions, styles — powered by AI
      </p>
    </div>

    <!-- Browser chrome -->
    <div class="browser-shell" data-sc-browser>
      <div class="b-glow"></div>

      <!-- Browser bar -->
      <div class="b-bar">
        <div class="b-dots"><span></span><span></span><span></span></div>
        <div class="b-url">
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          studio.viona.app
        </div>
        <div style="width:56px"></div>
      </div>

      <!-- ═══════════ EDITOR BODY ═══════════ -->
      <div class="editor-root">

        <!-- ── HEADER (h-12, editor-panel, mx-gap mt-gap) ── -->
        <div class="ed-header">
          <div class="ed-h-left">
            <button class="tb-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            </button>
          </div>
          <div class="ed-h-center">
            <button class="ed-title">
              Product Demo.mp4
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </div>
          <div class="ed-h-right">
            <button class="export-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
              Export
            </button>
          </div>
        </div>

        <!-- ── MAIN BODY ── -->
        <div class="ed-body">

          <!-- Icon Rail (w-14) -->
          <div class="icon-rail">
            <button class="ir-btn ir-active" id="ir-chat">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
              <span>Chat</span>
            </button>
            <button class="ir-btn" id="ir-captions">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M7 12h3m3 0h4M7 16h7" stroke-linecap="round"/></svg>
              <span>Captions</span>
            </button>
            <button class="ir-btn" id="ir-style">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <span>Style</span>
            </button>
            <button class="ir-btn" id="ir-assets">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
              <span>Assets</span>
            </button>
          </div>

          <!-- AI Chat Sidebar (w-[488px]) -->
          <div class="chat-panel sidebar-panel sp-visible" id="chat-panel">
            <div class="chat-header">
              <span class="chat-header-title">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/></svg>
                AI Chat
              </span>
              <button class="chat-close">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
              </button>
            </div>
            <div class="chat-messages">
              <!-- AI greeting -->
              <div class="msg msg-ai">
                <div class="msg-icon">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                </div>
                <div class="msg-bubble msg-bubble-ai">
                  Hey! I've loaded your video. What would you like to create?
                </div>
              </div>
              <!-- User message -->
              <div class="msg msg-user">
                <div class="msg-bubble msg-bubble-user">
                  Add dynamic captions with yellow highlights for key words
                </div>
              </div>
              <!-- AI response with progress -->
              <div class="msg msg-ai">
                <div class="msg-icon">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                </div>
                <div class="msg-bubble msg-bubble-ai">
                  <div class="msg-steps">
                    <div class="step step-done">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                      Transcribed audio
                    </div>
                    <div class="step step-done">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                      Generated captions
                    </div>
                    <div class="step step-done">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                      Applied Dynamic style
                    </div>
                  </div>
                  Done! Added 24 caption segments with Dynamic style. Key words are highlighted in yellow.
                </div>
              </div>
              <!-- User -->
              <div class="msg msg-user">
                <div class="msg-bubble msg-bubble-user">
                  Make the font bigger and add a subtle background
                </div>
              </div>
              <!-- AI streaming -->
              <div class="msg msg-ai">
                <div class="msg-icon">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                </div>
                <div class="msg-bubble msg-bubble-ai">
                  Updated font size to <strong>72px</strong> and added a soft dark background to all captions.<span class="typing-cursor"></span>
                </div>
              </div>
            </div>
            <div class="chat-quick">
              <button class="gen-btn" id="gen-btn">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/></svg>
                Generate Visuals
              </button>
            </div>
            <div class="chat-input-wrap">
              <div class="chat-input-row">
                <div class="chat-input-field">Ask Viona anything...</div>
                <button class="chat-send">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" stroke-linejoin="round"/></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- ── CAPTIONS PANEL ── -->
          <div class="sidebar-panel" id="captions-panel">
            <div class="sp-header">
              <span class="sp-header-title">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M7 12h3m3 0h4M7 16h7" stroke-linecap="round"/></svg>
                Captions
              </span>
              <div style="display:flex;gap:4px">
                <button class="sp-icon-btn">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35" stroke-linecap="round"/></svg>
                </button>
              </div>
            </div>
            <div class="cp-list">
              <div class="cp-item"><span class="cp-ts">0:00</span><span class="cp-text">Hey everyone welcome back to</span></div>
              <div class="cp-item"><span class="cp-ts">0:02</span><span class="cp-text">the channel, today we're talking</span></div>
              <div class="cp-item"><span class="cp-ts">0:05</span><span class="cp-text">about something really important</span></div>
              <div class="cp-item cp-active"><span class="cp-ts">0:08</span><span class="cp-text">making amazing video content fast</span></div>
              <div class="cp-item"><span class="cp-ts">0:11</span><span class="cp-text">with the help of AI tools</span></div>
              <div class="cp-item"><span class="cp-ts">0:14</span><span class="cp-text">that actually understand your style</span></div>
              <div class="cp-item"><span class="cp-ts">0:17</span><span class="cp-text">and match your brand perfectly</span></div>
              <div class="cp-item"><span class="cp-ts">0:20</span><span class="cp-text">let me show you how it works</span></div>
              <div class="cp-item"><span class="cp-ts">0:23</span><span class="cp-text">first upload your video file</span></div>
              <div class="cp-item"><span class="cp-ts">0:26</span><span class="cp-text">and Viona handles everything else</span></div>
            </div>
            <div class="sp-footer">
              <button class="sp-footer-btn">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
                Export SRT
              </button>
              <button class="sp-footer-btn sp-footer-btn-accent">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/></svg>
                Restyle All
              </button>
            </div>
          </div>

          <!-- ── STYLE PANEL ── -->
          <div class="sidebar-panel" id="style-panel">
            <div class="sp-header">
              <span class="sp-header-title">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                Style
              </span>
            </div>
            <!-- Top tabs -->
            <div class="sty-tabs">
              <button class="sty-tab sty-tab-on">Templates</button>
              <button class="sty-tab">Font</button>
              <button class="sty-tab">Position</button>
            </div>
            <!-- Category chips -->
            <div class="sty-cats">
              <button class="sty-cat sty-cat-on">Viral</button>
              <button class="sty-cat">Cinematic</button>
              <button class="sty-cat">Minimal</button>
              <button class="sty-cat">Ad</button>
            </div>
            <!-- Preset grid -->
            <div class="sty-grid">
              <div class="sty-card sty-card-sel">
                <div class="sty-preview" style="background:#111;"><span style="color:#fbbf24;font-weight:900;font-size:13px;letter-spacing:.04em;text-shadow:0 0 8px rgba(251,191,36,.5)">BOLD</span></div>
                <span class="sty-name">Bold Yellow</span>
              </div>
              <div class="sty-card">
                <div class="sty-preview" style="background:linear-gradient(135deg,#0d0d0d,#1a0a2e);"><span style="color:#a78bfa;font-weight:800;font-size:12px;text-shadow:0 0 10px rgba(167,139,250,.7)">DYNAMIC</span></div>
                <span class="sty-name">Dynamic</span>
              </div>
              <div class="sty-card">
                <div class="sty-preview" style="background:#000;"><span style="color:#4ade80;font-weight:900;font-size:13px;text-shadow:0 0 12px rgba(74,222,128,.8)">NEON</span></div>
                <span class="sty-name">Neon Green</span>
              </div>
              <div class="sty-card">
                <div class="sty-preview" style="background:#0a0a0a;"><span style="color:#fff;font-weight:900;font-size:12px;-webkit-text-stroke:1.5px #000">STREET</span></div>
                <span class="sty-name">Street</span>
              </div>
              <div class="sty-card">
                <div class="sty-preview" style="background:linear-gradient(135deg,#0d1117,#1c1c2e);"><span style="color:#fff;font-weight:400;font-size:11px;font-style:italic;opacity:.9">Cinema</span></div>
                <span class="sty-name">Cinematic</span>
              </div>
              <div class="sty-card">
                <div class="sty-preview" style="background:rgba(0,0,0,.6);"><span style="color:rgba(255,255,255,.85);font-size:10px;font-weight:400">Clean text</span></div>
                <span class="sty-name">Minimal</span>
              </div>
            </div>
          </div>

          <!-- ── ASSETS PANEL ── -->
          <div class="sidebar-panel" id="assets-panel">
            <div class="sp-header">
              <span class="sp-header-title">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
                Assets
              </span>
              <button class="sp-icon-btn">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
              </button>
            </div>
            <!-- Tabs -->
            <div class="sty-tabs">
              <button class="sty-tab sty-tab-on">Media</button>
              <button class="sty-tab">Shapes</button>
              <button class="sty-tab">Extracted</button>
            </div>
            <!-- Upload zone -->
            <div class="as-upload">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
              <span>Drop files or click to upload</span>
            </div>
            <!-- Asset grid -->
            <div class="as-grid">
              <div class="as-item as-item-video">
                <div class="as-thumb" style="background:linear-gradient(135deg,#1a1228,#0d1020)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="color:rgba(255,255,255,.4)"><polygon points="5 3 19 12 5 21"/></svg>
                </div>
                <span class="as-badge as-badge-vid">MP4</span>
                <span class="as-label">before.mp4</span>
              </div>
              <div class="as-item as-item-video">
                <div class="as-thumb" style="background:linear-gradient(135deg,#0d1a28,#081020)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="color:rgba(167,139,250,.6)"><polygon points="5 3 19 12 5 21"/></svg>
                </div>
                <span class="as-badge as-badge-ai">AI</span>
                <span class="as-label">after.mp4</span>
              </div>
              <div class="as-item">
                <div class="as-thumb" style="background:rgba(59,130,246,.12);border:1px dashed rgba(59,130,246,.25)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:rgba(96,165,250,.6)"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                </div>
                <span class="as-label">bg_01.png</span>
              </div>
              <div class="as-item">
                <div class="as-thumb" style="background:rgba(16,185,129,.1);border:1px dashed rgba(16,185,129,.2)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:rgba(52,211,153,.6)"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/></svg>
                </div>
                <span class="as-badge as-badge-aud">MP3</span>
                <span class="as-label">music.mp3</span>
              </div>
              <div class="as-item">
                <div class="as-thumb" style="background:rgba(245,158,11,.08);border:1px dashed rgba(245,158,11,.18)">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:rgba(252,211,77,.5)"><circle cx="12" cy="12" r="10"/><path d="M8 12h8M12 8v8" stroke-linecap="round"/></svg>
                </div>
                <span class="as-label">logo.svg</span>
              </div>
              <div class="as-item">
                <div class="as-thumb" style="background:rgba(139,92,246,.1);border:1px dashed rgba(139,92,246,.2)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:rgba(167,139,250,.6)"><rect x="3" y="3" width="18" height="18" rx="3"/></svg>
                </div>
                <span class="as-label">overlay.png</span>
              </div>
            </div>
          </div>

          <!-- Center: Preview + Timeline -->
          <div class="center-col">

            <!-- Preview panel (editor-panel glass) -->
            <div class="preview-panel">
              <!-- Video canvas -->
              <div class="video-canvas">
                <!-- 9:16 phone frame centered -->
                <div class="phone-frame">
                  <div class="phone-video">
                    <!-- Before: raw footage -->
                    <video id="vid-before" class="pv-vid" src="/videos/before.mp4" muted playsinline preload="auto"></video>
                    <!-- After: AI-enhanced -->
                    <video id="vid-after" class="pv-vid pv-after" src="/videos/after.mp4" muted playsinline preload="auto"></video>
                    <!-- Badge -->
                    <div class="pv-badge" id="pv-badge">
                      <span class="pv-dot pv-dot-raw"></span>Raw footage
                    </div>
                    <!-- Loading overlay -->
                    <div class="pv-loading" id="pv-loading">
                      <div class="pv-spinner"></div>
                      <span>Generating visuals…</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Playback bar (inside preview panel, at bottom) -->
              <div class="playback-bar">
                <button class="pb-btn">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><polygon points="19 20 9 12 19 4"/><line x1="5" y1="4" x2="5" y2="20" stroke="currentColor" stroke-width="2"/></svg>
                </button>
                <button class="pb-btn pb-play">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21"/></svg>
                </button>
                <button class="pb-btn">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 4 15 12 5 20"/><line x1="19" y1="4" x2="19" y2="20" stroke="currentColor" stroke-width="2"/></svg>
                </button>
                <span class="pb-time" id="pb-time">0:04.22</span>
                <div class="pb-scrubber">
                  <div class="pb-track">
                    <div class="pb-fill" id="pb-fill"></div>
                    <div class="pb-knob" id="pb-knob"></div>
                  </div>
                </div>
                <span class="pb-dur">0:32.00</span>
                <button class="pb-cc pb-cc-on">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M7 12h3m3 0h4M7 16h7" stroke-linecap="round"/></svg>
                </button>
              </div>
            </div>

            <!-- Timeline panel -->
            <div class="timeline-panel">
              <!-- Resize handle -->
              <div class="tl-resize-handle">
                <div class="tl-resize-bar"></div>
              </div>

              <!-- Add Item Toolbar -->
              <div class="add-toolbar">
                {["Text","Image","Audio","Video","Shape"].map((label, i) => (
                  <button class="add-btn">
                    {i === 0 && <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V5a2 2 0 00-2-2zM12 8v8M8 12h8" stroke-linecap="round"/></svg>}
                    {i === 1 && <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>}
                    {i === 2 && <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>}
                    {i === 3 && <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2"/><polygon points="10 8 16 12 10 16" fill="currentColor"/></svg>}
                    {i === 4 && <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>}
                    {label}
                  </button>
                ))}
              </div>

              <!-- Two-column: headers + canvas -->
              <div class="tl-body">
                <!-- Track headers -->
                <div class="tl-headers">
                  <div class="tl-ruler-spacer"></div>
                  <div class="tl-th">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2"/><polygon points="10 8 16 12 10 16" fill="currentColor"/></svg>
                    Video
                  </div>
                  <div class="tl-th">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M7 12h3m3 0h4" stroke-linecap="round"/></svg>
                    Captions
                  </div>
                  <div class="tl-th">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                    Audio
                  </div>
                </div>

                <!-- Canvas -->

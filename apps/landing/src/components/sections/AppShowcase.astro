  background: rgba(139,92,246,0.3) !important;
  border-color: rgba(139,92,246,0.55) !important;
  color: rgba(255,255,255,0.9) !important;
  box-shadow: 0 0 8px rgba(139,92,246,0.2);
}
.clip-audio {
  left: 0; right: 4px;
  background: rgba(16,185,129,0.12);
  border: 1px solid rgba(16,185,129,0.22);
}
.audio-wave {
  display: flex; align-items: center; gap: 1.5px; height: 100%; padding: 4px 4px;
}
.audio-wave span {
  display: inline-block; width: 2px; border-radius: 1px;
  background: rgba(52,211,153,0.5);
  animation: audioWave 1.2s ease-in-out infinite;
}
.audio-wave span:nth-child(odd)  { animation-delay: calc(var(--i, 0) * 0.05s); }
.audio-wave span:nth-child(even) { animation-delay: calc(var(--i, 0) * 0.07s + 0.1s); }
.audio-wave span:nth-child(1)  { height: 40%; }  .audio-wave span:nth-child(2)  { height: 70%; }
.audio-wave span:nth-child(3)  { height: 55%; }  .audio-wave span:nth-child(4)  { height: 85%; }
.audio-wave span:nth-child(5)  { height: 60%; }  .audio-wave span:nth-child(6)  { height: 40%; }
.audio-wave span:nth-child(7)  { height: 75%; }  .audio-wave span:nth-child(8)  { height: 50%; }
.audio-wave span:nth-child(9)  { height: 90%; }  .audio-wave span:nth-child(10) { height: 65%; }
.audio-wave span:nth-child(11) { height: 45%; }  .audio-wave span:nth-child(12) { height: 80%; }
.audio-wave span:nth-child(13) { height: 60%; }  .audio-wave span:nth-child(14) { height: 35%; }
.audio-wave span:nth-child(15) { height: 70%; }  .audio-wave span:nth-child(16) { height: 55%; }
.audio-wave span:nth-child(17) { height: 85%; }  .audio-wave span:nth-child(18) { height: 40%; }
.audio-wave span:nth-child(19) { height: 65%; }  .audio-wave span:nth-child(20) { height: 50%; }
.audio-wave span:nth-child(21) { height: 78%; }  .audio-wave span:nth-child(22) { height: 42%; }
.audio-wave span:nth-child(23) { height: 68%; }  .audio-wave span:nth-child(24) { height: 55%; }
.audio-wave span:nth-child(25) { height: 88%; }  .audio-wave span:nth-child(26) { height: 45%; }
.audio-wave span:nth-child(27) { height: 60%; }  .audio-wave span:nth-child(28) { height: 72%; }
@keyframes audioWave {
  0%,100% { transform: scaleY(0.6); }
  50%      { transform: scaleY(1.4); }
}

/* Playhead */
.playhead {
  position: absolute; top: 0; bottom: 0; width: 1.5px;
  background: white; left: 13%; pointer-events: none; z-index: 10;
}
.playhead-head {
  position: absolute; top: 0; left: 50%; transform: translateX(-50%);

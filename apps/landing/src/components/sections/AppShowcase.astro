  }

  .me-preset-name {
    font-size: 9px;
    font-weight: 600;
    color: rgba(255,255,255,0.5);
  }

  /* ── Style options ── */
  .me-style-section {
    margin-bottom: 12px;
  }
  .me-style-label {
    font-size: 10px;
    font-weight: 600;
    color: rgba(255,255,255,0.4);

---
---

<section class="bg-dark pt-16 sm:pt-20 lg:pt-28 pb-16 sm:pb-20 lg:pb-24 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center mb-12 sm:mb-16 lg:mb-20">
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-white mb-3 sm:mb-4 tracking-tight"
        data-showcase-heading
      >
        Your AI Video Editor
      </h2>
      <p
        class="text-sm sm:text-base text-white/40 max-w-md mx-auto"
        data-showcase-sub
      >
        Upload, enhance, export &mdash; it&rsquo;s that simple
      </p>
    </div>

    <!-- Screenshot stage -->
    <div class="relative max-w-[1100px] mx-auto" data-showcase-screens>
      <!-- Ambient glow -->
      <div class="showcase-glow" aria-hidden="true"></div>

      <!-- Primary screenshot — Chat view -->
      <div class="relative z-[2]" data-showcase-front>
        <div class="showcase-window">
          <div class="showcase-chrome">
            <div class="showcase-dots">
              <span></span><span></span><span></span>
            </div>
            <div class="showcase-url">studio.viona.app</div>
            <div class="showcase-dots" style="visibility:hidden">
              <span></span><span></span><span></span>
            </div>
          </div>
          <img
            src="/assets/screenshots/editor-chat.png"
            alt="Viona editor with AI chat assistant, video preview, and multi-track timeline"
            class="w-full block"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>

      <!-- Secondary screenshot — Captions view, floating bottom-right -->
      <div class="showcase-float" data-showcase-back>
        <div class="showcase-window showcase-window--float">
          <div class="showcase-chrome showcase-chrome--sm">
            <div class="showcase-dots showcase-dots--sm">
              <span></span><span></span><span></span>
            </div>
            <div class="showcase-url showcase-url--sm">studio.viona.app</div>
            <div class="showcase-dots showcase-dots--sm" style="visibility:hidden">
              <span></span><span></span><span></span>
            </div>
          </div>
          <img
            src="/assets/screenshots/editor-captions.png"
            alt="Viona editor showing caption settings with transcript scenes and timeline"
            class="w-full block"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Glow ── */
  .showcase-glow {
    position: absolute;
    top: -5%;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 70%;
    background: radial-gradient(
      ellipse at center,
      rgba(124, 58, 237, 0.1) 0%,
      rgba(124, 58, 237, 0.03) 50%,
      transparent 75%
    );
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  /* ── Window ── */
  .showcase-window {
    border-radius: 12px;
    overflow: hidden;
    background: #18181b;
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.03),
      0 4px 8px rgba(0, 0, 0, 0.15),
      0 12px 24px rgba(0, 0, 0, 0.2),
      0 32px 64px rgba(0, 0, 0, 0.3);
  }

  .showcase-window--float {
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.04),
      0 8px 16px rgba(0, 0, 0, 0.25),
      0 24px 48px rgba(0, 0, 0, 0.35),
      0 0 80px rgba(124, 58, 237, 0.06);
  }

  @media (min-width: 640px) {
    .showcase-window { border-radius: 16px; }
    .showcase-window--float { border-radius: 12px; }
  }

  /* ── Chrome ── */
  .showcase-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: #1f1f23;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .showcase-chrome--sm {
    padding: 6px 10px;
  }

  @media (max-width: 639px) {
    .showcase-chrome { padding: 6px 10px; }
    .showcase-chrome--sm { padding: 5px 8px; }
  }

  /* ── Dots ── */
  .showcase-dots {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }
  .showcase-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .showcase-dots span:nth-child(1) { background: #ff5f57; }
  .showcase-dots span:nth-child(2) { background: #ffbd2e; }
  .showcase-dots span:nth-child(3) { background: #28c840; }

  .showcase-dots--sm { gap: 4px; }
  .showcase-dots--sm span { width: 7px; height: 7px; }

  @media (max-width: 639px) {
    .showcase-dots { gap: 4px; }
    .showcase-dots span { width: 7px; height: 7px; }
    .showcase-dots--sm span { width: 5px; height: 5px; }
  }

  /* ── URL ── */
  .showcase-url {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    padding: 4px 16px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.3);
    text-align: center;
    max-width: 220px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .showcase-url--sm {
    font-size: 9px;
    padding: 3px 10px;
    max-width: 160px;
  }

  @media (max-width: 639px) {
    .showcase-url { font-size: 9px; padding: 3px 10px; }
    .showcase-url--sm { font-size: 7px; padding: 2px 6px; }
  }

  /* ── Float card ── */
  .showcase-float {
    position: absolute;
    bottom: -6%;
    right: -2%;
    width: 42%;
    z-index: 3;
  }

  @media (max-width: 639px) {
    .showcase-float {
      width: 52%;
      right: -1%;
      bottom: -4%;
    }
  }
</style>

<script>
  import { gsap } from "@/scripts/animations";

  document.addEventListener("astro:page-load", () => {
    const section = document
      .querySelector("[data-showcase-heading]")
      ?.closest("section");
    if (!section) return;

    gsap.set("[data-showcase-heading]", { opacity: 0, y: 30 });
    gsap.set("[data-showcase-sub]", { opacity: 0, y: 20 });
    gsap.set("[data-showcase-front]", { opacity: 0, y: 50 });
    gsap.set("[data-showcase-back]", { opacity: 0, y: 30, x: 20, scale: 0.96 });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.disconnect();

          const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

          tl.to("[data-showcase-heading]", {
            y: 0, opacity: 1, duration: 0.7,
          })
          .to("[data-showcase-sub]", {
            y: 0, opacity: 1, duration: 0.5,
          }, "-=0.4")
          .to("[data-showcase-front]", {
            y: 0, opacity: 1, duration: 1,
          }, "-=0.2")
          .to("[data-showcase-back]", {
            y: 0, x: 0, scale: 1, opacity: 1, duration: 0.9,
          }, "-=0.6");
        });
      },
      { threshold: 0.1 }
    );

    observer.observe(section);
  });
</script>

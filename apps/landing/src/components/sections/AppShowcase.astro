    animation: me-spin 0.6s linear infinite;
  }

  @keyframes me-spin {
    to { transform: rotate(360deg); }
  }

  /* ── Fake cursor ── */
  .me-cursor {
    position: absolute;
    z-index: 50;
    pointer-events: none;
    opacity: 0;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.4));

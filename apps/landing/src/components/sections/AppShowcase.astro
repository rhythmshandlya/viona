}
.as-badge-vid { background: rgba(239,68,68,0.2); color: rgba(252,165,165,0.9); }
.as-badge-ai  { background: rgba(139,92,246,0.25); color: rgba(196,181,253,0.9); }
.as-badge-aud { background: rgba(234,179,8,0.2); color: rgba(253,224,71,0.9); }

---
import { siteConfig } from "@/data/site";

const features = [
  {
    tag: "Captions",
    title: "20+ Creator-Grade Caption Styles",
    description: "From MrBeast's bold green highlights to Ali Abdaal's word-by-word fades. Pick a viral style, customize fonts, colors, animations, and glow effects — or build your own from scratch.",
    gradient: "from-violet-500/10 to-purple-500/10",
    border: "border-violet-200",
    items: ["MrBeast, Hormozi, Ali Abdaal presets", "Word-by-word & karaoke modes", "Stroke, shadow & neon glow effects", "200+ Google Fonts"],
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/></svg>`,
  },
  {
    tag: "AI Visuals",
    title: "Auto-Generated Visual Compositions",
    description: "Describe a process? You get a flowchart. Mention data? A chart appears. Our AI listens to your narration and generates contextual graphics — not generic stock footage.",
    gradient: "from-fuchsia-500/10 to-pink-500/10",
    border: "border-fuchsia-200",
    items: ["Flowcharts, timelines & diagrams", "Charts, stats & comparisons", "PiP, split-screen & fullscreen layouts", "4 visual themes to choose from"],
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>`,
  },
  {
    tag: "Multi-Platform",
    title: "One Video, Every Platform",
    description: "Export in 9:16 for TikTok & Reels, 16:9 for YouTube, 1:1 for Instagram, or 4:5 for ads. Built-in safe zone overlays show you exactly what viewers will see.",
    gradient: "from-blue-500/10 to-cyan-500/10",
    border: "border-blue-200",
    items: ["TikTok, Reels & Shorts safe zones", "Crop, pan & zoom controls", "Platform-specific preview mockups", "Export in any aspect ratio"],
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>`,
  },
  {
    tag: "Audio & B-Roll",
    title: "Clean Audio & B-Roll Integration",
    description: "AI removes filler words like 'um' and 'uh' automatically. Enhance audio clarity in one click. Upload your own B-roll or pull from Pexels stock — drag it right onto the timeline.",
    gradient: "from-emerald-500/10 to-teal-500/10",
    border: "border-emerald-200",
    items: ["Auto filler word removal", "One-click audio enhancement", "Pexels stock footage integration", "Multi-track timeline editing"],
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>`,
  },
  {
    tag: "AI Assistant",
    title: "Edit With Natural Language",
    description: "Just tell the AI what you want. \"Make the background darker\", \"Change the layout to split-screen\", \"Use warmer colors\". It understands your project and makes the changes live.",
    gradient: "from-amber-500/10 to-orange-500/10",
    border: "border-amber-200",
    items: ["Conversational editing interface", "Context-aware of your project", "Theme & layout suggestions", "Real-time visual updates"],
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
  },
  {
    tag: "Timeline",
    title: "Full Timeline Control",
    description: "A multi-track timeline with video, audio, captions, visuals, and B-roll tracks. Trim clips, adjust timing, reorder scenes, control volume per-track — everything a pro editor needs, without the complexity.",
    gradient: "from-rose-500/10 to-red-500/10",
    border: "border-rose-200",
    items: ["Multi-track video & audio", "Drag-and-drop clip editing", "Per-item volume & timing", "Keyboard shortcuts for speed"],
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>`,
  },
];
---

<section id="capabilities" class="py-12 sm:py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center mb-10 sm:mb-14 lg:mb-16">
      <p class="text-sm font-semibold text-primary mb-3 tracking-wide uppercase">What's inside</p>
      <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl leading-tight mb-4">
        Everything your videos<br /><em class="not-italic text-primary">were missing.</em>
      </h2>
      <p class="text-sm sm:text-base text-muted-foreground max-w-xl mx-auto">
        Captions, AI visuals, multi-platform export, filler word removal, B-roll — all in one editor, no switching tools.
      </p>
    </div>

    <!-- Feature grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      {features.map((feature) => (
        <div class={`group relative bg-gradient-to-br ${feature.gradient} rounded-2xl border ${feature.border} p-5 sm:p-6 transition-all duration-300 hover:shadow-lg hover:-translate-y-1 flex flex-col`}>
          <!-- Tag + Icon -->
          <div class="flex items-center gap-2 mb-3">
            <div class="w-8 h-8 rounded-lg bg-white/80 border border-white flex items-center justify-center text-primary">
              <Fragment set:html={feature.icon} />
            </div>
            <span class="text-xs font-semibold text-primary tracking-wide uppercase">{feature.tag}</span>
          </div>

          <!-- Title -->
          <h3 class="text-base sm:text-lg font-semibold mb-2 leading-snug">{feature.title}</h3>

          <!-- Description -->
          <p class="text-xs sm:text-sm text-muted-foreground mb-4 leading-relaxed">{feature.description}</p>

          <!-- Feature list -->
          <ul class="space-y-1.5 mb-4">
            {feature.items.map((item) => (
              <li class="flex items-start gap-2 text-xs sm:text-sm text-foreground/80">
                <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <!-- Screenshot for Captions card -->
          {feature.tag === "Captions" && (
            <div class="mt-auto rounded-xl overflow-hidden border border-white/60 shadow-sm">
              <img
                src="/assets/screenshots/editor-captions.png"
                alt="Viona caption editor with style presets and timeline"
                class="w-full block"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}

          <!-- Animated AI visual demo for AI Visuals card -->
          {feature.tag === "AI Visuals" && (
            <div class="mt-auto rounded-xl overflow-hidden border border-white/60 shadow-sm ai-visual-demo">
              <!-- Fake video frame -->
              <div class="ai-demo-frame">
                <!-- Main chart area -->
                <div class="ai-demo-chart">
                  <div class="ai-demo-chart-title">Revenue Growth</div>
                  <div class="ai-demo-bars">
                    <div class="ai-demo-bar-wrap">
                      <div class="ai-demo-bar" style="--h: 40%; --delay: 0s"></div>
                      <span>Q1</span>
                    </div>
                    <div class="ai-demo-bar-wrap">
                      <div class="ai-demo-bar" style="--h: 62%; --delay: 0.1s"></div>
                      <span>Q2</span>
                    </div>
                    <div class="ai-demo-bar-wrap">
                      <div class="ai-demo-bar" style="--h: 55%; --delay: 0.2s"></div>
                      <span>Q3</span>
                    </div>
                    <div class="ai-demo-bar-wrap">
                      <div class="ai-demo-bar ai-demo-bar--highlight" style="--h: 88%; --delay: 0.3s"></div>
                      <span>Q4</span>
                    </div>
                  </div>
                </div>
                <!-- AI badge -->
                <div class="ai-demo-badge">
                  <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 0l1.5 5.5L16 8l-6.5 2.5L8 16l-1.5-5.5L0 8l6.5-2.5z"/></svg>
                  AI generated
                </div>
                <!-- PiP person -->
                <div class="ai-demo-pip">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <circle cx="12" cy="8" r="4" opacity="0.6"/>
                    <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" opacity="0.4"/>
                  </svg>
                </div>
                <!-- Caption bar -->
                <div class="ai-demo-caption">
                  <span class="ai-caption-word">revenue</span>
                  <span class="ai-caption-word ai-caption-word--active">grew</span>
                  <span class="ai-caption-word">88%</span>
                  <span class="ai-caption-word">last</span>
                  <span class="ai-caption-word">quarter</span>
                </div>
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-10 sm:mt-14">
      <a href="#waitlist-form" class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-lg font-medium text-sm hover:bg-primary/90 transition-colors">
        Join Waitlist
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* ── AI Visual Demo ── */
  .ai-demo-frame {
    position: relative;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  /* Chart card */
  .ai-demo-chart {
    position: absolute;
    top: 12%;
    left: 8%;
    right: 30%;
    bottom: 22%;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 8px;
    padding: 10px 12px 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
  }

  .ai-demo-chart-title {
    font-size: 8px;
    font-weight: 700;
    color: #1a1a1a;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }

  .ai-demo-bars {
    flex: 1;
    display: flex;
    align-items: flex-end;
    gap: 5px;
  }

  .ai-demo-bar-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    height: 100%;
    justify-content: flex-end;
  }

  .ai-demo-bar-wrap span {
    font-size: 6px;
    color: #888;
    font-weight: 500;
  }

  .ai-demo-bar {
    width: 100%;
    height: var(--h);
    background: rgba(124, 58, 237, 0.3);
    border-radius: 3px 3px 0 0;
    animation: bar-grow 0.8s ease-out calc(var(--delay) + 0.3s) both;
    transform-origin: bottom;
  }

  .ai-demo-bar--highlight {
    background: #7C3AED;
  }

  @keyframes bar-grow {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  /* AI badge */
  .ai-demo-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    background: rgba(124, 58, 237, 0.9);
    color: white;
    font-size: 7px;
    font-weight: 600;
    padding: 3px 7px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 3px;
    backdrop-filter: blur(4px);
  }

  .ai-demo-badge svg {
    width: 7px;
    height: 7px;
    animation: sparkle-pulse 1.5s ease-in-out infinite;
  }

  @keyframes sparkle-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.3); }
  }

  /* PiP person */
  .ai-demo-pip {
    position: absolute;
    bottom: 18%;
    right: 6%;
    width: 18%;
    aspect-ratio: 1;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-demo-pip svg {
    width: 55%;
    height: 55%;
    color: rgba(255, 255, 255, 0.5);
  }

  /* Caption bar */
  .ai-demo-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 5px 8px;
    background: rgba(0, 0, 0, 0.55);
    display: flex;
    gap: 4px;
    justify-content: center;
    align-items: center;
  }

  .ai-caption-word {
    font-size: 8px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.02em;
  }

  .ai-caption-word--active {
    color: #a78bfa;
    background: rgba(124, 58, 237, 0.25);
    padding: 1px 4px;
    border-radius: 3px;
  }
</style>

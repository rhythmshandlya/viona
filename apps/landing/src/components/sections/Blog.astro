---
const features = [
  {
    id: "captions",
    title: "Captions",
    description: "MrBeast, Hormozi, Ali Abdaal presets. Word-by-word, karaoke, neon glow — customize everything.",
  },
  {
    id: "ai-visuals",
    title: "AI Visuals",
    description: "Flowcharts, charts & diagrams generated from your narration. No stock footage — real context.",
  },
  {
    id: "multi-platform",
    title: "Multi-Platform",
    description: "Export in 9:16 for TikTok & Reels, 16:9 for YouTube, 1:1 for Instagram. Safe zone overlays included.",
  },
  {
    id: "audio-broll",
    title: "Audio & B-Roll",
    description: "AI removes filler words automatically. Enhance audio in one click. Drag Pexels stock onto the timeline.",
  },
  {
    id: "ai-assistant",
    title: "AI Assistant",
    description: "\"Make it darker\", \"Switch to split-screen\" — edit with plain English. The AI understands your project.",
  },
  {
    id: "timeline",
    title: "Timeline",
    description: "Multi-track editor with video, audio, captions & visuals. Trim, reorder, adjust — full control.",
  },
];
---

<section id="capabilities" class="py-16 sm:py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center mb-12 sm:mb-16">
      <p class="text-sm font-semibold text-primary mb-3 tracking-wide uppercase" data-cap-label>What's Inside</p>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold leading-tight" data-cap-heading>
        Everything your videos<br /><span class="text-primary">were missing.</span>
      </h2>
    </div>

    <!-- Two-column layout -->
    <div class="grid lg:grid-cols-[1.2fr_1fr] gap-8 lg:gap-12 items-start">
      <!-- Left: Preview area -->
      <div class="relative rounded-2xl overflow-hidden bg-gradient-to-b from-[#1a1a2e] to-[#0d0d1a] aspect-[4/3] shadow-xl" data-cap-preview>
        <!-- Captions demo -->
        <div class="absolute inset-0 flex flex-col items-center justify-center px-6" id="demo-captions">
          <!-- Caption preview area -->
          <div class="mb-8 sm:mb-10 h-20 sm:h-24 flex items-center justify-center">
            <!-- MrBeast style -->
            <div class="caption-style active" data-caption="mrbeast">
              <span class="text-xl sm:text-2xl md:text-3xl font-black uppercase tracking-wide" style="color: #44ff44; text-shadow: 0 0 20px rgba(68,255,68,0.5), 3px 3px 0 #000; -webkit-text-stroke: 1px #000;">WATCH TIME</span>
              <span class="text-xl sm:text-2xl md:text-3xl font-black uppercase tracking-wide" style="color: #ffff00; text-shadow: 0 0 20px rgba(255,255,0,0.5), 3px 3px 0 #000; -webkit-text-stroke: 1px #000;"> UP 40%</span>
            </div>
            <!-- Hormozi style -->
            <div class="caption-style" data-caption="hormozi">
              <div class="text-center">
                <span class="text-xl sm:text-2xl md:text-3xl font-bold text-white uppercase">watch time up </span>
                <span class="text-xl sm:text-2xl md:text-3xl font-bold text-[#ff6b35] uppercase" style="text-shadow: 0 2px 10px rgba(255,107,53,0.4);">40%</span>
              </div>
            </div>
            <!-- Ali Abdaal style -->
            <div class="caption-style" data-caption="ali-abdaal">
              <div class="text-center space-y-1">
                <div class="text-lg sm:text-xl md:text-2xl font-medium text-white/90 tracking-wide" style="font-family: system-ui;">watch time up</div>
                <div class="text-2xl sm:text-3xl md:text-4xl font-semibold text-sky-400" style="font-family: system-ui;">40%</div>
              </div>
            </div>
            <!-- Karaoke style -->
            <div class="caption-style" data-caption="karaoke">
              <div class="text-center text-xl sm:text-2xl md:text-3xl font-bold uppercase tracking-wider">
                <span class="text-primary karaoke-word" data-k="0">watch </span>
                <span class="text-white/40 karaoke-word" data-k="1">time </span>
                <span class="text-white/40 karaoke-word" data-k="2">up </span>
                <span class="text-white/40 karaoke-word" data-k="3">40%</span>
              </div>
            </div>
            <!-- Neon style -->
            <div class="caption-style" data-caption="neon">
              <div class="text-center text-xl sm:text-2xl md:text-3xl font-bold uppercase" style="color: #e040fb; text-shadow: 0 0 7px #e040fb, 0 0 20px #e040fb, 0 0 40px #e040fb;">
                watch time up <span style="color: #00e5ff; text-shadow: 0 0 7px #00e5ff, 0 0 20px #00e5ff, 0 0 40px #00e5ff;">40%</span>
              </div>
            </div>
          </div>

          <!-- Preset pills -->
          <div class="flex flex-wrap justify-center gap-2 sm:gap-2.5">
            <button class="caption-pill active px-3 py-1.5 rounded-full text-xs font-medium border border-primary/50 bg-primary/15 text-primary transition-all duration-200" data-pill="mrbeast">MrBeast</button>
            <button class="caption-pill px-3 py-1.5 rounded-full text-xs font-medium border border-white/20 bg-white/5 text-white/60 hover:border-white/40 transition-all duration-200" data-pill="hormozi">Hormozi</button>
            <button class="caption-pill px-3 py-1.5 rounded-full text-xs font-medium border border-white/20 bg-white/5 text-white/60 hover:border-white/40 transition-all duration-200" data-pill="ali-abdaal">Ali Abdaal</button>
            <button class="caption-pill px-3 py-1.5 rounded-full text-xs font-medium border border-white/20 bg-white/5 text-white/60 hover:border-white/40 transition-all duration-200" data-pill="karaoke">Karaoke</button>
            <button class="caption-pill px-3 py-1.5 rounded-full text-xs font-medium border border-white/20 bg-white/5 text-white/60 hover:border-white/40 transition-all duration-200" data-pill="neon">Neon Glow</button>
          </div>
        </div>

        <!-- AI Visuals demo -->
        <div class="absolute inset-0 flex items-center justify-center px-8 opacity-0 pointer-events-none" id="demo-ai-visuals">
          <div class="w-full max-w-xs">
            <div class="text-white/50 text-xs font-medium mb-3 text-center">AI-Generated Diagram</div>
            <div class="space-y-3">
              <div class="bg-primary/20 border border-primary/30 rounded-lg px-4 py-2.5 text-center text-sm text-white font-medium">Record Video</div>
              <div class="flex justify-center"><div class="w-0.5 h-4 bg-primary/40"></div></div>
              <div class="bg-primary/30 border border-primary/40 rounded-lg px-4 py-2.5 text-center text-sm text-white font-medium">AI Transcribes</div>
              <div class="flex justify-center"><div class="w-0.5 h-4 bg-primary/40"></div></div>
              <div class="bg-primary/40 border border-primary/50 rounded-lg px-4 py-2.5 text-center text-sm text-white font-medium">Visuals Generated</div>
            </div>
          </div>
        </div>

        <!-- Multi-Platform demo -->
        <div class="absolute inset-0 flex items-center justify-center gap-4 sm:gap-6 px-6 opacity-0 pointer-events-none" id="demo-multi-platform">
          <div class="w-16 sm:w-20 bg-white/10 border border-white/20 rounded-lg aspect-[9/16] flex items-center justify-center">
            <span class="text-[9px] sm:text-[10px] text-white/40 font-medium">9:16</span>
          </div>
          <div class="w-28 sm:w-36 bg-white/10 border border-white/20 rounded-lg aspect-video flex items-center justify-center">
            <span class="text-[10px] sm:text-xs text-white/40 font-medium">16:9</span>
          </div>
          <div class="w-20 sm:w-24 bg-white/10 border border-white/20 rounded-lg aspect-square flex items-center justify-center">
            <span class="text-[10px] sm:text-xs text-white/40 font-medium">1:1</span>
          </div>
        </div>

        <!-- Audio & B-Roll demo -->
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 px-8 opacity-0 pointer-events-none" id="demo-audio-broll">
          <div class="w-full max-w-sm">
            <div class="flex items-center gap-2 mb-4">
              <div class="text-white/50 text-xs font-medium">Audio</div>
              <div class="flex-1 h-8 bg-white/5 rounded-lg flex items-center px-2 gap-[2px]">
                {Array.from({length: 40}).map(() => (
                  <div class="flex-1 bg-primary/50 rounded-full" style={`height: ${Math.random() * 100}%`}></div>
                ))}
              </div>
            </div>
            <div class="flex items-center gap-3 bg-white/5 rounded-lg px-3 py-2">
              <span class="text-red-400 text-xs line-through">um, so basically, uh</span>
              <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              <span class="text-green-400 text-xs">so basically</span>
            </div>
          </div>
        </div>

        <!-- AI Assistant demo -->
        <div class="absolute inset-0 flex items-center justify-center px-8 opacity-0 pointer-events-none" id="demo-ai-assistant">
          <div class="w-full max-w-xs space-y-3">
            <div class="bg-white/10 rounded-xl rounded-bl-sm px-4 py-2.5 text-sm text-white/80 self-start max-w-[85%]">
              Make the background darker and add a neon glow to the title
            </div>
            <div class="bg-primary/20 border border-primary/30 rounded-xl rounded-br-sm px-4 py-2.5 text-sm text-white/80 ml-auto max-w-[85%]">
              Done! I've darkened the background to #0a0a14 and added a purple neon glow to the title text.
            </div>
          </div>
        </div>

        <!-- Timeline demo -->
        <div class="absolute inset-0 flex flex-col justify-end px-4 sm:px-6 pb-6 sm:pb-8 opacity-0 pointer-events-none" id="demo-timeline">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="text-[10px] text-white/40 w-12 text-right shrink-0">Video</span>
              <div class="flex-1 h-6 sm:h-7 bg-primary/30 rounded flex items-center px-2"><span class="text-[10px] text-white/60">talking-head.mp4</span></div>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] text-white/40 w-12 text-right shrink-0">Audio</span>
              <div class="flex-1 h-6 sm:h-7 bg-green-500/20 rounded flex items-center px-2"><span class="text-[10px] text-white/60">enhanced-audio.wav</span></div>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] text-white/40 w-12 text-right shrink-0">Captions</span>
              <div class="flex-1 h-6 sm:h-7 flex gap-1">
                <div class="flex-[2] bg-yellow-500/20 rounded px-2 flex items-center"><span class="text-[10px] text-white/60">Intro</span></div>
                <div class="flex-[3] bg-yellow-500/30 rounded px-2 flex items-center"><span class="text-[10px] text-white/60">Main point</span></div>
                <div class="flex-[1] bg-yellow-500/20 rounded"></div>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] text-white/40 w-12 text-right shrink-0">Visuals</span>
              <div class="flex-1 h-6 sm:h-7 flex gap-1">
                <div class="flex-[1] bg-purple-500/20 rounded"></div>
                <div class="flex-[2] bg-purple-500/30 rounded px-2 flex items-center"><span class="text-[10px] text-white/60">Chart</span></div>
                <div class="flex-[2] bg-purple-500/20 rounded px-2 flex items-center"><span class="text-[10px] text-white/60">Flowchart</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Feature tabs -->
      <div class="flex flex-col gap-1" data-cap-tabs>
        {features.map((feature, i) => (
          <button
            class:list={[
              "feature-tab text-left w-full rounded-xl px-5 py-4 transition-all duration-300 border",
              i === 0 ? "bg-primary/5 border-primary/20 active" : "bg-transparent border-transparent hover:bg-gray-50",
            ]}
            data-tab={feature.id}
          >
            <h3 class="text-base font-semibold mb-0 transition-colors duration-300">{feature.title}</h3>
            <p
              class:list={[
                "text-sm text-muted-foreground mt-1.5 leading-relaxed transition-all duration-300 overflow-hidden",
                i === 0 ? "max-h-24 opacity-100" : "max-h-0 opacity-0",
              ]}
              data-tab-desc
            >
              {feature.description}
            </p>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .caption-style {
    display: none;
    text-align: center;
  }
  .caption-style.active {
    display: block;
  }
</style>

<script>
  import { gsap } from "@/scripts/animations";

  document.addEventListener("astro:page-load", () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>(".feature-tab");
    const demos = new Map<string, HTMLElement>();

    tabs.forEach((tab) => {
      const id = tab.dataset.tab;
      if (id) {
        const el = document.getElementById(`demo-${id}`);
        if (el) demos.set(id, el);
      }
    });

    let activeId = "captions";

    // --- Per-demo entrance animations ---
    const animateDemo = (id: string) => {
      const demo = demos.get(id);
      if (!demo) return;

      if (id === "captions") {
        // Animate the active caption style
        const active = demo.querySelector(".caption-style.active");
        if (active) gsap.fromTo(active, { scale: 0.8, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.4, ease: "back.out(1.5)" });
        gsap.fromTo(demo.querySelectorAll(".caption-pill"), { y: 10, opacity: 0 }, { y: 0, opacity: 1, duration: 0.3, stagger: 0.05, delay: 0.15 });
      }

      if (id === "ai-visuals") {
        const boxes = demo.querySelectorAll("[class*='bg-primary']");
        gsap.fromTo(boxes, { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, stagger: 0.12, ease: "power2.out" });
      }

      if (id === "multi-platform") {
        const frames = demo.querySelectorAll("[class*='aspect-']");
        gsap.fromTo(frames, { scale: 0.7, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.5, stagger: 0.1, ease: "back.out(1.2)" });
      }

      if (id === "audio-broll") {
        const bars = demo.querySelectorAll("[class*='bg-primary/50']");
        gsap.fromTo(bars, { scaleY: 0 }, { scaleY: 1, duration: 0.5, stagger: 0.01, ease: "power2.out" });
        const fillerRow = demo.querySelector("[class*='flex items-center gap-3']");
        if (fillerRow) gsap.fromTo(fillerRow, { y: 15, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, delay: 0.3 });
      }

      if (id === "ai-assistant") {
        const bubbles = demo.querySelectorAll("[class*='rounded-xl']");
        gsap.fromTo(bubbles, { x: -20, opacity: 0 }, { x: 0, opacity: 1, duration: 0.4, stagger: 0.2, ease: "power2.out" });
      }

      if (id === "timeline") {
        const tracks = demo.querySelectorAll("[class*='flex items-center gap-2']");
        gsap.fromTo(tracks, { x: -30, opacity: 0 }, { x: 0, opacity: 1, duration: 0.35, stagger: 0.08, ease: "power2.out" });
      }
    };

    const switchTab = (newId: string) => {
      if (newId === activeId) return;

      // Update tab styles
      tabs.forEach((tab) => {
        const id = tab.dataset.tab!;
        const desc = tab.querySelector("[data-tab-desc]") as HTMLElement;
        if (id === newId) {
          tab.classList.add("bg-primary/5", "border-primary/20", "active");
          tab.classList.remove("bg-transparent", "border-transparent");
          if (desc) { desc.style.maxHeight = "6rem"; desc.style.opacity = "1"; }
        } else {
          tab.classList.remove("bg-primary/5", "border-primary/20", "active");
          tab.classList.add("bg-transparent", "border-transparent");
          if (desc) { desc.style.maxHeight = "0"; desc.style.opacity = "0"; }
        }
      });

      // Crossfade demos
      const oldDemo = demos.get(activeId);
      const newDemo = demos.get(newId);

      if (oldDemo) {
        gsap.to(oldDemo, { opacity: 0, duration: 0.2, onComplete: () => {
          oldDemo.classList.add("pointer-events-none");
        }});
      }
      if (newDemo) {
        newDemo.classList.remove("pointer-events-none");
        gsap.to(newDemo, { opacity: 1, duration: 0.3, delay: 0.1, onComplete: () => {
          animateDemo(newId);
        }});
      }

      activeId = newId;
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const id = tab.dataset.tab;
        if (id) switchTab(id);
      });
    });

    // --- Caption preset switching ---
    const pills = document.querySelectorAll<HTMLButtonElement>(".caption-pill");
    const captionStyles = document.querySelectorAll<HTMLElement>(".caption-style");
    let karaokeInterval: ReturnType<typeof setInterval> | null = null;
    let activePill = "mrbeast";

    const stopKaraoke = () => {
      if (karaokeInterval) { clearInterval(karaokeInterval); karaokeInterval = null; }
    };

    const startKaraoke = () => {
      stopKaraoke();
      const words = document.querySelectorAll<HTMLElement>(".karaoke-word");
      let idx = 0;
      const highlight = () => {
        words.forEach((w, i) => {
          w.classList.toggle("text-primary", i === idx);
          w.classList.toggle("text-white/40", i !== idx);
        });
        idx = (idx + 1) % words.length;
      };
      highlight();
      karaokeInterval = setInterval(highlight, 600);
    };

    const switchCaption = (preset: string) => {
      if (preset === activePill) return;
      stopKaraoke();

      // Update pills
      pills.forEach((p) => {
        if (p.dataset.pill === preset) {
          p.classList.add("active", "border-primary/50", "bg-primary/15", "text-primary");
          p.classList.remove("border-white/20", "bg-white/5", "text-white/60");
        } else {
          p.classList.remove("active", "border-primary/50", "bg-primary/15", "text-primary");
          p.classList.add("border-white/20", "bg-white/5", "text-white/60");
        }
      });

      // Swap caption styles with animation
      captionStyles.forEach((s) => {
        if (s.dataset.caption === preset) {
          s.classList.add("active");
          gsap.fromTo(s, { scale: 0.85, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.35, ease: "back.out(1.5)" });
        } else {
          s.classList.remove("active");
        }
      });

      if (preset === "karaoke") startKaraoke();
      activePill = preset;
    };

    pills.forEach((pill) => {
      pill.addEventListener("click", (e) => {
        e.stopPropagation();
        const preset = pill.dataset.pill;
        if (preset) switchCaption(preset);
      });
    });

    // Entrance animation
    const section = document.getElementById("capabilities");
    if (section) {
      gsap.set(["[data-cap-label]", "[data-cap-heading]", "[data-cap-preview]", "[data-cap-tabs]"], { opacity: 0, y: 30 });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            observer.disconnect();
            const tl = gsap.timeline({ defaults: { ease: "power2.out" } });
            tl.to("[data-cap-label]", { y: 0, opacity: 1, duration: 0.4 })
              .to("[data-cap-heading]", { y: 0, opacity: 1, duration: 0.5 }, "-=0.2")
              .to("[data-cap-preview]", { y: 0, opacity: 1, duration: 0.6 }, "-=0.2")
              .to("[data-cap-tabs]", { y: 0, opacity: 1, duration: 0.5 }, "-=0.3")
              .add(() => animateDemo("captions"), "-=0.2");
          });
        },
        { threshold: 0.1 }
      );
      observer.observe(section);
    }
  });
</script>

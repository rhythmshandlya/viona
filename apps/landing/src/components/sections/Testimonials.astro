---
import { testimonials } from "@/data/testimonials";
---

<section class="py-20 bg-dark text-white">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Header -->
    <div class="mb-12">
      <h2 class="text-3xl sm:text-4xl font-semibold">What Creators Say</h2>
    </div>

    <!-- Avatar row -->
    <div class="flex items-center gap-4 mb-8">
      {testimonials.map((_, i) => (
        <div class={`w-14 h-14 rounded-xl bg-gradient-to-br from-gray-600 to-gray-700 ${i === 0 ? 'ring-2 ring-primary' : ''}`}></div>
      ))}
    </div>

    <!-- Testimonial content -->
    <div class="max-w-3xl">
      <blockquote class="text-lg sm:text-xl leading-relaxed text-white/80 mb-8">
        "{testimonials[0]?.quote}"
      </blockquote>

      <div class="flex items-center justify-between">
        <div>
          <div class="font-semibold">{testimonials[0]?.author}</div>
          <div class="text-sm text-white/60">{testimonials[0]?.role}, {testimonials[0]?.company}</div>
        </div>

        <!-- Navigation dots -->
        <div class="flex items-center gap-3">
          <button class="nav-dot active"></button>
          <button class="nav-dot"></button>
          <button class="w-8 h-8 rounded-full bg-primary flex items-center justify-center hover:bg-primary/90">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

---
import { testimonials } from "@/data/testimonials";
---

<section class="py-20 lg:py-28 border-t border-border">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mb-16">
      <h2 class="animate-on-scroll text-3xl sm:text-4xl font-semibold tracking-tight mb-4">
        What creators say
      </h2>
      <p class="animate-on-scroll text-muted-foreground" style="animation-delay: 0.05s;">
        Trusted by thousands of creators worldwide.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 stagger-children">
      {testimonials.map((testimonial) => (
        <div class="space-y-6">
          <p class="text-sm leading-relaxed">"{testimonial.quote}"</p>
          <div>
            <div class="font-medium text-sm">{testimonial.author}</div>
            <div class="text-sm text-muted-foreground">
              {testimonial.role}, {testimonial.company}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

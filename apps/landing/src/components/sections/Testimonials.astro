---
import { testimonials } from "@/data/testimonials";

const featured = testimonials.filter((t) => t.featured);
const rest = testimonials.filter((t) => !t.featured);
---

<section class="py-12 sm:py-16 lg:py-24 bg-dark text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center mb-10 sm:mb-14">
      <p class="text-sm font-semibold text-primary mb-3 tracking-wide uppercase">Testimonials</p>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold">
        Loved by <span class="text-primary">Creators</span>
      </h2>
    </div>

    <!-- Featured testimonials — large cards -->
    <div class="grid md:grid-cols-3 gap-4 sm:gap-6 mb-4 sm:mb-6">
      {featured.map((t) => (
        <div class="bg-white/[0.06] backdrop-blur-sm border border-white/10 rounded-2xl p-5 sm:p-6 flex flex-col">
          <!-- Stars -->
          <div class="flex gap-0.5 mb-4">
            {[...Array(5)].map(() => (
              <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="text-sm sm:text-base text-white/75 leading-relaxed mb-6 flex-1">
            "{t.quote}"
          </blockquote>

          <!-- Author -->
          <div class="flex items-center gap-3">
            <img
              src={t.avatar}
              alt={t.author}
              class="w-10 h-10 rounded-full object-cover ring-2 ring-primary/30"
              loading="lazy"
            />
            <div>
              <div class="font-semibold text-sm">{t.author}</div>
              <div class="text-xs text-white/50">{t.role}, {t.company}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Rest — smaller cards -->
    <div class="grid md:grid-cols-3 gap-4 sm:gap-6">
      {rest.map((t) => (
        <div class="bg-white/[0.04] border border-white/[0.06] rounded-2xl p-5 sm:p-6 flex flex-col">
          <!-- Quote -->
          <blockquote class="text-sm text-white/65 leading-relaxed mb-5 flex-1">
            "{t.quote}"
          </blockquote>

          <!-- Author -->
          <div class="flex items-center gap-3">
            <img
              src={t.avatar}
              alt={t.author}
              class="w-9 h-9 rounded-full object-cover ring-1 ring-white/10"
              loading="lazy"
            />
            <div>
              <div class="font-medium text-sm">{t.author}</div>
              <div class="text-xs text-white/40">{t.role}, {t.company}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

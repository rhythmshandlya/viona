---
import { siteConfig } from "@/data/site";
---

<section id="features" class="py-12 sm:py-16 lg:py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">

      <!-- Left: Before/After sequential reveal card -->
      <div class="flex justify-center" data-reveal-container>
        <div class="relative w-[260px] sm:w-[300px]">
          <!-- Phone frame -->
          <div class="reveal-phone" data-reveal-phone>

            <!-- BEFORE state -->
            <div class="reveal-state reveal-state--before" data-reveal-before>
              <div class="reveal-label">
                <span class="reveal-label-dot reveal-label-dot--muted"></span>
                Before
              </div>
              <div class="reveal-frame">
                <!-- Plain talking head placeholder -->
                <div class="reveal-placeholder">
                  <div class="reveal-transcript">
                    <div class="reveal-transcript-line">
                      <span class="rt-word rt-filler">um</span>
                      <span class="rt-word">so</span>
                      <span class="rt-word">today</span>
                      <span class="rt-word">we'll</span>
                    </div>
                    <div class="reveal-transcript-line">
                      <span class="rt-word rt-filler">uh</span>
                      <span class="rt-word">talk</span>
                      <span class="rt-word">about</span>
                      <span class="rt-word rt-filler">like</span>
                    </div>
                    <div class="reveal-transcript-line">
                      <span class="rt-word">the</span>
                      <span class="rt-word">growth</span>
                      <span class="rt-word">rate</span>
                      <span class="rt-word rt-filler">basically</span>
                    </div>
                    <div class="reveal-transcript-line">
                      <span class="rt-word rt-filler">you know</span>
                      <span class="rt-word">of</span>
                      <span class="rt-word">our</span>
                    </div>
                  </div>
                </div>
                <!-- Fake caption bar -->
                <div class="reveal-caption-raw">
                  <span>um so today we'll talk about uh the...</span>
                </div>
              </div>
            </div>

            <!-- AFTER state (hidden initially) -->
            <div class="reveal-state reveal-state--after" data-reveal-after>
              <div class="reveal-label reveal-label--after">
                <svg class="reveal-sparkle" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M8 0l1.5 5.5L16 8l-6.5 2.5L8 16l-1.5-5.5L0 8l6.5-2.5z"/>
                </svg>
                After Viona
              </div>
              <div class="reveal-frame">
                <video
                  class="reveal-video"
                  data-video-inline
                  src="/assets/sample-output.mp4"
                  poster="/assets/sample-output-poster.jpg"
                  playsinline
                  loop
                  muted
                  preload="none"
                ></video>
                <!-- Play button (shown until first play) -->
                <button
                  class="reveal-play"
                  data-video-play
                  aria-label="Play sample output video"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Content -->
      <div>
        <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl leading-tight mb-4 sm:mb-6">
          Your viewers don't learn<br />from talking heads.
          <br /><em class="not-italic text-primary">They learn from visuals.</em>
        </h2>

        <p class="text-sm sm:text-base text-muted-foreground mb-6 sm:mb-8 leading-relaxed">
          Most talking-head videos lose viewers in the first 30 seconds — not because the
          content is bad, but because there's nothing to look at. Viona listens to your
          explanation and generates the exact visual that belongs there: a chart when you cite
          a stat, a diagram when you describe a process, a comparison when you contrast two ideas.
        </p>

        <ul class="space-y-2 mb-6 sm:mb-8 text-sm sm:text-base">
          <li class="flex items-start gap-3">
            <span class="text-primary font-semibold mt-0.5">→</span>
            <span>Flowcharts, timelines, stat cards, comparisons — picked automatically</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary font-semibold mt-0.5">→</span>
            <span>Filler words removed before you even see the transcript</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary font-semibold mt-0.5">→</span>
            <span>Edit any visual with a single sentence — the AI regenerates it</span>
          </li>
        </ul>

        <a href="#waitlist-form" class="btn-primary">
          Join Waitlist
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>


<style>
  /* ── Phone frame ── */
  .reveal-phone {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 24px;
    overflow: hidden;
    background: #0e0e14;
    box-shadow:
      0 0 0 2px rgba(255,255,255,0.08),
      0 16px 48px rgba(0,0,0,0.4),
      0 4px 16px rgba(0,0,0,0.3),
      0 0 40px rgba(139,92,246,0.08);
  }

  /* ── States ── */
  .reveal-state {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
  }

  .reveal-state--before {
    z-index: 2;
  }

  .reveal-state--after {
    z-index: 3;
    opacity: 0;
    pointer-events: none;
  }

  .reveal-state--after.is-revealed {
    pointer-events: auto;
  }

  /* ── Label ── */
  .reveal-label {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    color: rgba(255,255,255,0.5);
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.08);
    backdrop-filter: blur(12px);
  }

  .reveal-label--after {
    color: var(--color-primary);
    background: rgba(139,92,246,0.12);
    border-color: rgba(139,92,246,0.2);
  }

  .reveal-label-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .reveal-label-dot--muted {
    background: rgba(255,255,255,0.3);
  }

  .reveal-sparkle {
    width: 12px;
    height: 12px;
    color: var(--color-primary);
  }

  /* ── Frame ── */
  .reveal-frame {
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  /* ── Transcript placeholder (Before state) ── */
  .reveal-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(14,14,20,0.95) 0%, rgba(10,10,16,1) 100%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 20px 16px;
  }

  .reveal-transcript {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .reveal-transcript-line {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .rt-word {
    font-size: 11px;
    font-weight: 500;
    color: rgba(255,255,255,0.5);
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(255,255,255,0.06);
  }

  .rt-filler {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
    text-decoration: line-through;
  }

  .reveal-caption-raw {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 10px 14px;
    background: rgba(0, 0, 0, 0.6);
    font-size: 11px;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.4;
  }

  /* ── Inline video ── */
  .reveal-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Play button ── */
  .reveal-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.3),
      0 0 30px rgba(255,255,255,0.1);
    backdrop-filter: blur(12px);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .reveal-play:hover {
    transform: translate(-50%, -50%) scale(1.08);
    box-shadow:
      0 6px 28px rgba(0, 0, 0, 0.35),
      0 0 40px rgba(255,255,255,0.15);
  }

  .reveal-play svg {
    width: 22px;
    height: 22px;
    color: var(--color-primary);
    margin-left: 2px;
  }

  .reveal-play.is-hidden {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
</style>

<script>
  import { gsap } from "@/scripts/animations";

  document.addEventListener("astro:page-load", () => {
    const container = document.querySelector("[data-reveal-container]");
    if (!container) return;

    const before = document.querySelector("[data-reveal-before]");
    const after = document.querySelector("[data-reveal-after]");
    const phone = document.querySelector("[data-reveal-phone]");

    if (!before || !after || !phone) return;

    // Scroll-triggered reveal
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.disconnect();

          // Wait a beat so user sees the "before" state
          gsap.timeline({ delay: 1.2 })
            // Flash + scale pulse
            .to(phone, {
              scale: 0.94,
              duration: 0.25,
              ease: "power2.in",
            })
            .to(phone, {
              boxShadow: "0 0 40px rgba(124, 58, 237, 0.3), 0 16px 40px rgba(0,0,0,0.1)",
              duration: 0.15,
            }, "<")
            // Swap states
            .to(before, {
              opacity: 0,
              duration: 0.3,
              ease: "power2.inOut",
            })
            .to(after, {
              opacity: 1,
              duration: 0.3,
              ease: "power2.inOut",
              onComplete: () => {
                (after as HTMLElement).classList.add("is-revealed");
                (before as HTMLElement).style.pointerEvents = "none";
              },
            }, "<")
            // Bounce back
            .to(phone, {
              scale: 1,
              duration: 0.4,
              ease: "back.out(1.7)",
            })
            .to(phone, {
              boxShadow: "0 4px 12px rgba(0,0,0,0.08), 0 16px 40px rgba(0,0,0,0.1), 0 0 0 1px rgba(0,0,0,0.05)",
              duration: 0.5,
            }, "<");
        });
      },
      { threshold: 0.4 }
    );

    observer.observe(container);

    // Inline video play/pause
    const video = document.querySelector("[data-video-inline]") as HTMLVideoElement;
    const playBtn = document.querySelector("[data-video-play]") as HTMLElement;

    if (!video || !playBtn) return;

    playBtn.addEventListener("click", () => {
      video.play();
      playBtn.classList.add("is-hidden");
    });

    video.addEventListener("click", () => {
      if (video.paused) {
        video.play();
        playBtn.classList.add("is-hidden");
      } else {
        video.pause();
        playBtn.classList.remove("is-hidden");
      }
    });
  });
</script>

---
import { features } from "@/data/features";
---

<section id="features" class="py-20 lg:py-28 border-t border-border">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mb-16">
      <h2 class="animate-on-scroll text-3xl sm:text-4xl font-semibold tracking-tight mb-4">
        Everything you need
      </h2>
      <p class="animate-on-scroll text-muted-foreground" style="animation-delay: 0.05s;">
        Powerful features designed for creators who want to move fast.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 stagger-children">
      {features.map((feature) => (
        <div class="space-y-3">
          <h3 class="font-medium">{feature.title}</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

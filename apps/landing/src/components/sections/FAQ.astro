---
import { faqs } from "@/data/testimonials";
import Container from "@/components/ui/Container.astro";
---

<section id="faq" class="py-24 lg:py-32">
  <Container size="narrow">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block text-sm font-medium text-primary uppercase tracking-wider mb-4">FAQ</span>
      <h2 class="animate-on-scroll text-4xl sm:text-5xl lg:text-6xl mb-6">
        Frequently asked
        <span class="text-primary italic">questions</span>
      </h2>
      <p class="animate-on-scroll text-lg text-muted-foreground font-sans" style="animation-delay: 0.1s;">
        Everything you need to know about Cllipify.
      </p>
    </div>

    <!-- FAQ Accordion -->
    <div class="stagger-children">
      {faqs.map((faq) => (
        <details class="group">
          <summary>
            {faq.question}
          </summary>
          <div>
            <p class="text-muted-foreground leading-relaxed">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </Container>
</section>

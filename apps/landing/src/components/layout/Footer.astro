---
import { siteConfig } from "@/data/site";
---

<footer class="py-12 sm:py-16 border-t border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-8 mb-8 sm:mb-12">
      <!-- Brand -->
      <div class="col-span-2 sm:col-span-3 lg:col-span-1 mb-4 lg:mb-0">
        <a href="/" class="flex items-center gap-2 mb-4">
          <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="currentColor">
            <path d="M4 4h4v4H4V4zm6 0h4v4h-4V4zm6 0h4v4h-4V4zM4 10h4v4H4v-4zm6 0h4v4h-4v-4zm6 0h4v4h-4v-4zM4 16h4v4H4v-4zm6 0h4v4h-4v-4zm6 0h4v4h-4v-4z"/>
          </svg>
          <span class="font-semibold">{siteConfig.name}</span>
        </a>
        <p class="text-xs sm:text-sm text-muted-foreground mb-4">
          Transform your explainer videos with AI-generated visuals.
        </p>
        <a href="mailto:hello@viona.app" class="text-xs sm:text-sm text-muted-foreground hover:text-foreground transition-colors">
          hello@viona.app
        </a>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="text-xs sm:text-sm font-semibold text-primary mb-3 sm:mb-4">Navigation</h4>
        <ul class="space-y-2 sm:space-y-3">
          {siteConfig.footer.product.map((item) => (
            <li>
              <a href={item.href} class="text-xs sm:text-sm text-muted-foreground hover:text-foreground transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-xs sm:text-sm font-semibold text-primary mb-3 sm:mb-4">Company</h4>
        <ul class="space-y-2 sm:space-y-3">
          {siteConfig.footer.company.map((item) => (
            <li>
              <a href={item.href} class="text-xs sm:text-sm text-muted-foreground hover:text-foreground transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="text-xs sm:text-sm font-semibold text-primary mb-3 sm:mb-4">Legal</h4>
        <ul class="space-y-2 sm:space-y-3">
          {siteConfig.footer.legal.map((item) => (
            <li>
              <a href={item.href} class="text-xs sm:text-sm text-muted-foreground hover:text-foreground transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Newsletter -->
      <div class="col-span-2 sm:col-span-1">
        <h4 class="text-xs sm:text-sm font-semibold text-primary mb-3 sm:mb-4">Stay updated</h4>
        <div class="flex gap-2">
          <input
            type="email"
            placeholder="Email"
            class="flex-1 min-w-0 px-3 py-2 text-xs sm:text-sm border border-white/[0.08] rounded-xl bg-white/[0.04] focus:outline-none focus:border-primary/50 transition-colors text-foreground placeholder:text-white/30"
          />
          <button class="w-10 h-10 sm:w-10 sm:h-10 bg-primary text-white rounded-xl flex items-center justify-center hover:bg-primary/90 transition-all flex-shrink-0" style="box-shadow: 0 2px 8px rgba(139,92,246,0.3), inset 0 1px 0 rgba(255,255,255,0.15);" aria-label="Subscribe to newsletter">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-6 sm:pt-8 border-t border-white/[0.06] flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs sm:text-sm text-muted-foreground text-center sm:text-left">
        © {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
      </p>
      <div class="flex gap-4">
        <a href={siteConfig.links.twitter} class="p-2 -m-1 text-muted-foreground hover:text-foreground transition-colors" aria-label="Follow us on X">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <a href="https://linkedin.com/company/viona" class="p-2 -m-1 text-muted-foreground hover:text-foreground transition-colors" aria-label="Follow us on LinkedIn">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a href={siteConfig.links.github} class="p-2 -m-1 text-muted-foreground hover:text-foreground transition-colors" aria-label="View our GitHub">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

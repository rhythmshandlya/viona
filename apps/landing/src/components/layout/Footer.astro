---
import { siteConfig } from "@/data/site";
import Container from "@/components/ui/Container.astro";
---

<footer class="relative border-t border-border py-20 bg-muted/30">
  <Container>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-10 lg:gap-16">
      <!-- Brand -->
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5.14v14l11-7-11-7z" />
            </svg>
          </div>
          <span class="text-xl font-bold tracking-tight">{siteConfig.name}</span>
        </a>
        <p class="text-muted-foreground max-w-xs mb-6 leading-relaxed">
          Transform your ideas into stunning videos with AI-powered generation. Built for the next generation of creators.
        </p>
        <div class="flex gap-3">
          <a
            href={siteConfig.links.twitter}
            class="w-10 h-10 rounded-full bg-card border border-border flex items-center justify-center text-muted-foreground hover:text-primary hover:border-primary transition-colors"
            aria-label="Twitter"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
          <a
            href={siteConfig.links.github}
            class="w-10 h-10 rounded-full bg-card border border-border flex items-center justify-center text-muted-foreground hover:text-primary hover:border-primary transition-colors"
            aria-label="GitHub"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Product Links -->
      <div>
        <h4 class="font-semibold mb-5 text-sm uppercase tracking-wider text-muted-foreground">Product</h4>
        <ul class="space-y-3">
          {siteConfig.footer.product.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-foreground/80 hover:text-primary transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h4 class="font-semibold mb-5 text-sm uppercase tracking-wider text-muted-foreground">Company</h4>
        <ul class="space-y-3">
          {siteConfig.footer.company.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-foreground/80 hover:text-primary transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal Links -->
      <div>
        <h4 class="font-semibold mb-5 text-sm uppercase tracking-wider text-muted-foreground">Legal</h4>
        <ul class="space-y-3">
          {siteConfig.footer.legal.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-foreground/80 hover:text-primary transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 mt-16 pt-8 border-t border-border">
      <p class="text-sm text-muted-foreground">
        &copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
      </p>
      <p class="text-sm text-muted-foreground">
        Crafted with care for creators everywhere.
      </p>
    </div>
  </Container>
</footer>

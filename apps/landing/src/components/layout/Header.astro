---
import { siteConfig } from "@/data/site";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
---

<header class="fixed top-0 left-0 right-0 z-50">
  <div class="bg-background/80 backdrop-blur-xl border-b border-border/50">
    <Container>
      <nav class="flex items-center justify-between h-20">
        <!-- Logo with fun animation -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="relative">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-primary via-secondary to-accent flex items-center justify-center shadow-lg group-hover:shadow-xl transition-all duration-300 group-hover:scale-110 group-hover:rotate-3">
              <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5.14v14l11-7-11-7z" />
              </svg>
            </div>
            <!-- Fun sparkle -->
            <div class="absolute -top-1 -right-1 w-3 h-3 bg-accent rounded-full animate-pulse"></div>
          </div>
          <span class="text-xl font-bold tracking-tight">{siteConfig.name}</span>
        </a>

        <!-- Desktop Nav -->
        <div class="hidden md:flex items-center gap-8">
          {siteConfig.nav.map((item) => (
            <a
              href={item.href}
              class="text-sm font-medium text-muted-foreground hover:text-primary transition-all duration-300 hover:scale-105 relative group"
            >
              {item.label}
              <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gradient-to-r from-primary to-secondary rounded-full transition-all group-hover:w-full"></span>
            </a>
          ))}
        </div>

        <!-- CTA Buttons -->
        <div class="hidden sm:flex items-center gap-4">
          <a
            href={siteConfig.appUrl}
            class="text-sm font-medium text-muted-foreground hover:text-primary transition-colors"
          >
            Sign In
          </a>
          <Button href={siteConfig.appUrl} size="sm">
            Get Started
            <span class="text-lg">✨</span>
          </Button>
        </div>

        <!-- Mobile Menu Button -->
        <button
          class="sm:hidden p-2 -mr-2 text-muted-foreground hover:text-primary rounded-xl hover:bg-muted transition-all hover-wiggle"
          aria-label="Open menu"
          id="mobile-menu-btn"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </nav>
    </Container>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden sm:hidden fixed inset-0 top-20 bg-background/95 backdrop-blur-xl z-40"
  >
    <Container>
      <nav class="flex flex-col gap-2 py-6">
        {siteConfig.nav.map((item, i) => (
          <a
            href={item.href}
            class="text-lg font-semibold text-muted-foreground hover:text-primary transition-all py-4 border-b border-border hover:translate-x-2"
            style={`animation-delay: ${i * 0.1}s`}
          >
            {item.label}
          </a>
        ))}
        <a href={siteConfig.appUrl} class="text-lg font-semibold text-muted-foreground hover:text-primary py-4 border-b border-border">
          Sign In
        </a>
        <div class="pt-6">
          <Button href={siteConfig.appUrl} size="lg" class="w-full">
            Get Started Free ✨
          </Button>
        </div>
      </nav>
    </Container>
  </div>
</header>

<script>
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  menuBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
    document.body.classList.toggle("overflow-hidden");
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
      document.body.classList.remove("overflow-hidden");
    });
  });
</script>

---
import { siteConfig } from "@/data/site";
---

<header class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-sm border-b border-border">
  <div class="max-w-6xl mx-auto px-6">
    <nav class="flex items-center justify-between h-16">
      <a href="/" class="font-semibold text-lg">
        {siteConfig.name}
      </a>

      <div class="hidden md:flex items-center gap-8">
        {siteConfig.nav.map((item) => (
          <a
            href={item.href}
            class="text-sm text-muted-foreground hover:text-foreground transition-colors"
          >
            {item.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-4">
        <a
          href={siteConfig.appUrl}
          class="text-sm text-muted-foreground hover:text-foreground transition-colors hidden sm:block"
        >
          Sign in
        </a>
        <a
          href={siteConfig.appUrl}
          class="text-sm font-medium bg-foreground text-background px-4 py-2 rounded-md hover:opacity-90 transition-opacity"
        >
          Get Started
        </a>
      </div>
    </nav>
  </div>
</header>

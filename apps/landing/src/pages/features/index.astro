---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { featurePages } from "@/data/feature-pages";
import { siteConfig } from "@/data/site";
import CTA from "@/components/sections/CTA.astro";
---

<BaseLayout
  title="Features"
  description="Every Viona feature: AI chat editor, 20+ animated caption templates, auto-generated visuals, filler-word removal, multi-format export, and more."
>
  <section class="pt-32 pb-20 lg:pt-40">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16">
        <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight mb-4">
          Features
        </h1>
        <p class="text-muted-foreground max-w-2xl mx-auto">
          An AI video editor for every kind of video. Prompt any edit — Viona cuts, captions,
          and builds visuals for you.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {featurePages.map((f) => (
          <a href={`/features/${f.slug}/`} class="card-elevated p-6 block hover:ring-1 hover:ring-primary/40 transition">
            <div class="text-xs font-medium text-primary mb-3">{f.tagline}</div>
            <h2 class="text-xl font-semibold mb-3">{f.name}</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">{f.summary}</p>
            <div class="mt-4 text-sm font-medium text-primary">Learn more →</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-20">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-4">
        More than just these three
      </h2>
      <p class="text-muted-foreground leading-relaxed mb-8">
        Word-level transcription, automatic filler-word removal, multi-format export (9:16, 16:9, 1:1),
        safe-zone preview for every platform, custom fonts and colors, team collaboration — they all
        ship in every plan. Start free to try the editor.
      </p>
      <a href={siteConfig.appUrl} class="btn-primary inline-flex justify-center">Start editing free</a>
    </div>
  </section>

  <CTA />
</BaseLayout>

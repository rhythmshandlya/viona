---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTA from "@/components/sections/CTA.astro";
---

<BaseLayout
  title="About"
  description="Learn about Cllipify's mission to democratize video creation with AI."
>
  <section class="pt-32 pb-16 lg:pt-40 lg:pb-24">
    <div class="max-w-2xl mx-auto px-6">
      <h1 class="animate-on-scroll text-4xl sm:text-5xl font-semibold tracking-tight mb-6">
        About
      </h1>
      <p class="animate-on-scroll text-lg text-muted-foreground mb-12" style="animation-delay: 0.05s;">
        Making video creation accessible to everyone.
      </p>

      <div class="space-y-12 animate-on-scroll" style="animation-delay: 0.1s;">
        <div>
          <h2 class="font-medium mb-3">Our Mission</h2>
          <p class="text-muted-foreground leading-relaxed">
            Cllipify was founded to democratize video creation. We saw how powerful video
            content could be, but also how inaccessible traditional video production remained
            for most people.
          </p>
        </div>

        <div>
          <h2 class="font-medium mb-3">The Problem</h2>
          <p class="text-muted-foreground leading-relaxed">
            Creating professional videos traditionally requires expensive software,
            specialized skills, and hours of editing time. This creates a significant
            barrier for small businesses and creators.
          </p>
        </div>

        <div>
          <h2 class="font-medium mb-3">Our Approach</h2>
          <p class="text-muted-foreground leading-relaxed">
            By combining AI with an intuitive interface, we've made it possible for anyone
            to create videos in minutes. Describe what you want, and our AI handles the rest.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

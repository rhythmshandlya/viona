---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PricingSection from "@/components/sections/Pricing.astro";
import FAQ from "@/components/sections/FAQ.astro";
import CTA from "@/components/sections/CTA.astro";
---

<BaseLayout
  title="Pricing"
  description="Simple, transparent pricing for Cllipify. Start free and scale as you grow."
>
  <section class="pt-32 pb-12 lg:pt-40">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h1 class="animate-on-scroll text-4xl sm:text-5xl font-semibold tracking-tight mb-4">
        Pricing
      </h1>
      <p class="animate-on-scroll text-muted-foreground" style="animation-delay: 0.05s;">
        Start free. Upgrade when you're ready.
      </p>
    </div>
  </section>

  <PricingSection />
  <FAQ />
  <CTA />
</BaseLayout>

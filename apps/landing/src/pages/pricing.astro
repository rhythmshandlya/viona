---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pricingTiers } from "@/data/pricing";
import { siteConfig } from "@/data/site";
import CTA from "@/components/sections/CTA.astro";
---

<BaseLayout
  title="Pricing"
  description="Simple pricing for Viona. Start free with 5 videos per month, upgrade for more."
>
  <section class="pt-32 pb-20 lg:pt-40">
    <div class="max-w-6xl mx-auto px-6">
      <!-- Header -->
      <div class="text-center mb-16">
        <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight mb-4">
          Simple <span class="wavy-underline">Pricing</span>
        </h1>
        <p class="text-muted-foreground max-w-lg mx-auto">
          Start free and scale as you grow. No hidden fees.
        </p>
      </div>

      <!-- Pricing cards -->
      <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        {pricingTiers.map((tier) => (
          <div class={`card-elevated p-8 ${tier.popular ? 'ring-2 ring-primary' : ''}`}>
            {tier.popular && (
              <div class="text-xs font-medium text-primary mb-4">Most Popular</div>
            )}
            <h3 class="font-semibold mb-2">{tier.name}</h3>
            <div class="flex items-baseline gap-1 mb-4">
              <span class="text-4xl font-semibold">{tier.price}</span>
              <span class="text-muted-foreground">/{tier.period}</span>
            </div>
            <p class="text-sm text-muted-foreground mb-6">{tier.description}</p>

            <ul class="space-y-3 mb-8">
              {tier.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm">
                  <div class="feature-check mt-0.5">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-muted-foreground">{feature}</span>
                </li>
              ))}
            </ul>

            <a
              href={siteConfig.appUrl}
              class={tier.popular ? 'btn-primary w-full justify-center' : 'btn-outline w-full justify-center block text-center'}
            >
              {tier.cta}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Feature Comparison Table -->
  <section class="pb-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-center mb-12">
        Compare Plans
      </h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-border">
              <th class="text-left py-4 pr-4 font-medium text-muted-foreground">Feature</th>
              <th class="text-center py-4 px-4 font-semibold">Starter</th>
              <th class="text-center py-4 px-4 font-semibold">Pro</th>
              <th class="text-center py-4 px-4 font-semibold">Enterprise</th>
            </tr>
          </thead>
          <tbody class="text-muted-foreground">
            <tr class="border-b border-border/50">
              <td class="py-3 pr-4">Videos per month</td>
              <td class="text-center py-3 px-4">5</td>
              <td class="text-center py-3 px-4">50</td>
              <td class="text-center py-3 px-4">Unlimited</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="py-3 pr-4">Export quality</td>
              <td class="text-center py-3 px-4">720p</td>
              <td class="text-center py-3 px-4">4K</td>
              <td class="text-center py-3 px-4">4K+</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="py-3 pr-4">AI transcription</td>
              <td class="text-center py-3 px-4">Yes</td>
              <td class="text-center py-3 px-4">Yes</td>
              <td class="text-center py-3 px-4">Yes</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="py-3 pr-4">AI visual generation</td>
              <td class="text-center py-3 px-4">Yes</td>
              <td class="text-center py-3 px-4">Yes</td>
              <td class="text-center py-3 px-4">Yes</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="py-3 pr-4">Filler word removal</td>
              <td class="text-center py-3 px-4">Yes</td>
              <td class="text-center py-3 px-4">Yes</td>
              <td class="text-center py-3 px-4">Yes</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="py-3 pr-4">Subtitle templates</td>
              <td class="text-center py-3 px-4">Basic</td>
              <td class="text-center py-3 px-4">Premium</td>
              <td class="text-center py-3 px-4">Custom</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="py-3 pr-4">Custom branding</td>
              <td class="text-center py-3 px-4">&mdash;</td>
              <td class="text-center py-3 px-4">Yes</td>
              <td class="text-center py-3 px-4">Yes</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="py-3 pr-4">Watermark-free export</td>
              <td class="text-center py-3 px-4">&mdash;</td>
              <td class="text-center py-3 px-4">Yes</td>
              <td class="text-center py-3 px-4">Yes</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="py-3 pr-4">Team collaboration</td>
              <td class="text-center py-3 px-4">&mdash;</td>
              <td class="text-center py-3 px-4">Yes</td>
              <td class="text-center py-3 px-4">Yes</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="py-3 pr-4">API access</td>
              <td class="text-center py-3 px-4">&mdash;</td>
              <td class="text-center py-3 px-4">&mdash;</td>
              <td class="text-center py-3 px-4">Yes</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="py-3 pr-4">SSO & advanced security</td>
              <td class="text-center py-3 px-4">&mdash;</td>
              <td class="text-center py-3 px-4">&mdash;</td>
              <td class="text-center py-3 px-4">Yes</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="py-3 pr-4">Custom integrations</td>
              <td class="text-center py-3 px-4">&mdash;</td>
              <td class="text-center py-3 px-4">&mdash;</td>
              <td class="text-center py-3 px-4">Yes</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="py-3 pr-4">SLA guarantee</td>
              <td class="text-center py-3 px-4">&mdash;</td>
              <td class="text-center py-3 px-4">&mdash;</td>
              <td class="text-center py-3 px-4">Yes</td>
            </tr>
            <tr>
              <td class="py-3 pr-4">Support</td>
              <td class="text-center py-3 px-4">Community</td>
              <td class="text-center py-3 px-4">Priority</td>
              <td class="text-center py-3 px-4">Dedicated</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="pb-20">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-center mb-12">
        Frequently Asked Questions
      </h2>
      <div class="space-y-8">
        <div>
          <h3 class="font-semibold mb-2">Can I switch plans at any time?</h3>
          <p class="text-muted-foreground leading-relaxed">
            Yes. You can upgrade or downgrade your plan at any time from your account settings.
            When upgrading, you will be charged the prorated difference for the remainder of your
            billing cycle. When downgrading, the new rate takes effect at the start of your next
            billing period, and you keep access to your current plan features until then.
          </p>
        </div>
        <div>
          <h3 class="font-semibold mb-2">What happens if I exceed my monthly video limit?</h3>
          <p class="text-muted-foreground leading-relaxed">
            On the Starter plan, you will not be able to process additional videos until the next
            month. On the Pro plan, you can purchase additional video credits as needed. Enterprise
            customers have unlimited video processing included in their agreement.
          </p>
        </div>
        <div>
          <h3 class="font-semibold mb-2">Is there a free trial for the Pro plan?</h3>
          <p class="text-muted-foreground leading-relaxed">
            Yes. The Pro plan includes a 14-day free trial with full access to all Pro features.
            No credit card is required to start the trial. If you decide not to continue, your
            account will automatically revert to the Starter plan at the end of the trial period.
          </p>
        </div>
        <div>
          <h3 class="font-semibold mb-2">What video formats and lengths are supported?</h3>
          <p class="text-muted-foreground leading-relaxed">
            Viona supports all common video formats including MP4, MOV, and WebM. There is no
            strict length limit, but processing time increases with video duration. Most users
            upload videos between 2 and 30 minutes. For very long recordings, we recommend
            splitting them into shorter segments for the best results.
          </p>
        </div>
        <div>
          <h3 class="font-semibold mb-2">Do you offer annual billing?</h3>
          <p class="text-muted-foreground leading-relaxed">
            Yes. Annual billing is available for the Pro plan at a discounted rate. Contact us
            for details on annual pricing and any active promotions. Enterprise agreements
            are also available on an annual basis with custom terms.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Money-back Guarantee -->
  <section class="pb-20">
    <div class="max-w-3xl mx-auto px-6">
      <div class="card-elevated p-8 sm:p-12 text-center">
        <h2 class="text-2xl font-semibold mb-4">30-Day Money-Back Guarantee</h2>
        <p class="text-muted-foreground leading-relaxed max-w-xl mx-auto">
          We are confident you will love Viona. If you are not satisfied with the Pro plan for
          any reason within the first 30 days of your paid subscription, contact us and we will
          issue a full refund—no questions asked. We want you to feel completely comfortable
          trying Viona without any risk.
        </p>
      </div>
    </div>
  </section>

  <!-- Enterprise Contact -->
  <section class="pb-20">
    <div class="max-w-3xl mx-auto px-6">
      <div class="card-elevated p-8 sm:p-12 text-center">
        <h2 class="text-2xl font-semibold mb-4">Need a Custom Solution?</h2>
        <p class="text-muted-foreground leading-relaxed max-w-xl mx-auto mb-6">
          For large teams, agencies, and organizations with specific requirements, our Enterprise
          plan offers unlimited videos, custom integrations, API access, dedicated support, and
          SLA guarantees. Let us build a plan that fits your workflow.
        </p>
        <a
          href="mailto:hello@viona.app"
          class="btn-primary inline-flex justify-center"
        >
          Contact Sales
        </a>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found">
  <section class="min-h-[80vh] flex items-center justify-center">
    <div class="max-w-md mx-auto px-6 text-center">
      <h1 class="text-6xl font-semibold mb-4">404</h1>
      <p class="text-muted-foreground mb-8">
        Page not found.
      </p>
      <a
        href="/"
        class="inline-block text-sm font-medium bg-foreground text-background px-6 py-3 rounded-md hover:opacity-90 transition-opacity"
      >
        Back to Home
      </a>
    </div>
  </section>
</BaseLayout>

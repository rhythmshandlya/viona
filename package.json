{
  "name": "reelify",
  "private": true,
  "scripts": {
    "dev": "pnpm run /^dev:/",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter @reelify/api dev",
    "dev:worker": "pnpm --filter @reelify/worker dev",
    "build": "pnpm run --parallel build:*",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter @reelify/api build",
    "build:worker": "pnpm --filter @reelify/worker build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build-sandbox": "docker build -t clipify-openhands-sandbox:latest ./docker/openhands-sandbox",
    "docker:test-sandbox": "docker run --rm --entrypoint python clipify-openhands-sandbox:latest /opt/openhands/tests/test_sdk_imports.py",
    "db:migrate": "pnpm --filter @reelify/api db:migrate",
    "db:seed": "pnpm --filter @reelify/api db:seed",
    "setup": "pnpm install && pnpm docker:up && pnpm db:migrate",
    "setup:macos": "bash scripts/setup-macos.sh",
    "setup:whisperx": "pnpm --filter @reelify/worker whisperx:setup",
    "setup:enhance": "pnpm --filter @reelify/worker enhance:setup",
    "proxy": "pnpm --filter @reelify/worker proxy",
    "lint": "pnpm run --parallel lint",
    "typecheck": "pnpm run --parallel typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {},
  "dependencies": {
    "@react-spring/three": "^10.0.3",
    "@react-three/drei": "^10.7.7"
  }
}

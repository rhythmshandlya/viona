{
  "name": "viona",
  "private": true,
  "scripts": {
    "dev": "pnpm run /^dev:/",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter @viona/api dev",
    "dev:worker": "pnpm --filter @viona/worker dev",
    "dev:render": "pnpm --filter @viona/render-service dev",
    "build": "pnpm run --parallel build:*",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter @viona/api build",
    "build:worker": "pnpm --filter @viona/worker build",
    "build:landing": "pnpm --filter landing build",
    "build:mcp-servers": "pnpm --filter @viona/mcp-servers build",
    "preview:landing": "pnpm --filter landing preview",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build-sandbox": "docker build -t viona-openhands-sandbox:latest ./docker/openhands-sandbox",
    "docker:test-sandbox": "docker run --rm --entrypoint python viona-openhands-sandbox:latest /opt/openhands/tests/test_sdk_imports.py",
    "db:migrate": "pnpm --filter @viona/api db:migrate",
    "db:seed": "pnpm --filter @viona/api db:seed",
    "setup": "pnpm install && pnpm docker:up && pnpm db:migrate",
    "deploy": "pwsh -ExecutionPolicy Bypass -File ./scripts/deploy.ps1",
    "deploy:link": "railway link -p 84a07d3b-cbeb-42ce-a189-bd3516d59879 -e production",
    "deploy:web": "cp apps/web/railway.toml railway.toml && railway link -p 84a07d3b-cbeb-42ce-a189-bd3516d59879 -s web -e production && railway up -d",
    "deploy:api": "cp packages/api/railway.toml railway.toml && railway link -p 84a07d3b-cbeb-42ce-a189-bd3516d59879 -s api -e production && railway up -d",
    "deploy:worker": "cp packages/worker/railway.toml railway.toml && railway link -p 84a07d3b-cbeb-42ce-a189-bd3516d59879 -s worker -e production && railway up -d",
    "deploy:render": "cp packages/render-service/railway.toml railway.toml && railway link -p 84a07d3b-cbeb-42ce-a189-bd3516d59879 -s render-service -e production && railway up -d",
    "deploy:all": "pnpm deploy:web && pnpm deploy:api && pnpm deploy:worker && pnpm deploy:render",
    "templates:publish:prod": "pnpm --filter @viona/templates templates:publish",
    "lint": "pnpm run --parallel lint",
    "typecheck": "pnpm run --parallel typecheck",
    "push-tokens": "pnpm --filter @viona/worker push-tokens"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3"
  }
}
